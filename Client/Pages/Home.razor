            Print a title block on PDF and DXF exports
        </label>

        <div class="lf-tb-row">
            <span class="lf-tb-label">Sheet size</span>
            <select class="device-input" id="tb-sheet-size" name="tb-sheet-size" @bind="_titleBlock.SheetSize">
                <option value="11x17">11×17 (Tabloid)</option>
                <option value="Letter">Letter (8.5×11)</option>
                <option value="A4">A4</option>
            </select>
            <span class="lf-tb-hint">landscape</span>
        </div>

        <div class="lf-tb-section">This sheet — @_sheets[_activeSheetIndex].Name</div>
        <div class="lf-tb-grid">
            <input class="device-input" placeholder="Drawing title" @bind="_sheets[_activeSheetIndex].DrawingTitle" />
            <input class="device-input" placeholder="Drawing number (e.g. AV-101)" @bind="_sheets[_activeSheetIndex].DrawingNumber" />
        </div>

        <div class="lf-tb-section">Project</div>
        <div class="lf-tb-grid">
            <input class="device-input" placeholder="Client (e.g. CLARK CONSTRUCTION)" @bind="_titleBlock.Client" />
            <input class="device-input" placeholder="Project name" @bind="_titleBlock.ProjectName" />
            <input class="device-input" placeholder="Location (e.g. WASHINGTON, DC)" @bind="_titleBlock.Location" />
            <input class="device-input" placeholder="Discipline (e.g. TELECOM)" @bind="_titleBlock.Discipline" />
        </div>

        <div class="lf-tb-section">Issue</div>
        <div class="lf-tb-grid">
            <input class="device-input" placeholder="Project number" @bind="_titleBlock.ProjectNumber" />
            <input class="device-input" placeholder="Date" @bind="_titleBlock.Date" />
            <input class="device-input" placeholder="Drawn by" @bind="_titleBlock.DrawnBy" />
            <input class="device-input" placeholder="Checked by" @bind="_titleBlock.CheckedBy" />
        </div>

        <div class="lf-tb-section">Logo</div>
        <div class="lf-tb-logo">
            @if (!string.IsNullOrEmpty(_logoDataUri))
            {
                <img class="lf-tb-logo-preview" src="@_logoDataUri" alt="Title block logo" />
                <button class="device-action-btn device-action-delete" title="Remove logo" @onclick="RemoveLogo">🗑</button>
            }
            else
            {
                <span class="lf-tb-hint">No logo — the box prints empty.</span>
            }
            <label class="add-device-btn lf-tb-upload">
                @(_logoBusy ? "Uploading…" : "⬆ Upload logo")
                <InputFile OnChange="UploadLogo" accept="image/*" />
            </label>
        </div>
        <div class="lf-tb-hint">Shared by every diagram, and printed on the PDF only — the DXF keeps an empty box.</div>
        @if (!string.IsNullOrEmpty(_logoError))
        {
            <div class="lf-tb-error">@_logoError</div>
        }

        <div class="lf-tb-section">Company</div>
        <div class="lf-tb-grid">
            <input class="device-input" placeholder="Company name" @bind="_titleBlock.CompanyName" />
            <input class="device-input" placeholder="Address" @bind="_titleBlock.CompanyAddress" />
            <input class="device-input" placeholder="Phone" @bind="_titleBlock.CompanyPhone" />
            <input class="device-input" placeholder="Website" @bind="_titleBlock.CompanyWeb" />
        </div>

        <div class="lf-tb-section">Revisions</div>
        @foreach (var rev in _titleBlock.Revisions)
        {
            var r = rev;
            <div class="lf-tb-rev">
                <input class="device-input lf-tb-rev-num" placeholder="#" @bind="r.Number" />
                <input class="device-input lf-tb-rev-date" placeholder="Date" @bind="r.Date" />
                <input class="device-input" placeholder="Description" @bind="r.Description" />
                <button class="device-action-btn device-action-delete" title="Remove revision"
                        @onclick="() => _titleBlock.Revisions.Remove(r)">🗑</button>
            </div>
        }
        <button class="add-device-btn" @onclick="AddRevision">+ Add Revision</button>

        <button class="add-device-btn" style="margin-top:10px;" @onclick="CloseTitleBlock">✔ Done</button>
    </div>
}

@if (_deviceColorModalOpen)
