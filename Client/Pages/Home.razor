    // Sets/creates a connection's label (shared by the manual modal and auto-labeling).
    private void ApplyLabelToLink(ElbowLinkModel elbow, string text)
    {
        elbow.LabelText = text;
        if (elbow.LabelNode == null)
        {
            var node = new ConnectionLabelNode(ComputeLinkMidpoint(elbow)) { Text = text, OwnerLink = elbow };
            elbow.LabelNode = node;
            _diagram.Nodes.Add(node);
        }
        else
        {
            elbow.LabelNode.Text = text;
            elbow.LabelNode.Refresh();
        }
        SyncBreakTagText(elbow);
    }

    // Keeps a broken connection's two tag blocks showing the current label.
    private void SyncBreakTagText(ElbowLinkModel elbow)
    {
        var text = elbow.LabelText ?? "";
        if (elbow.SrcTagNode != null) { elbow.SrcTagNode.Text = text; elbow.SrcTagNode.Refresh(); }
        if (elbow.TgtTagNode != null) { elbow.TgtTagNode.Text = text; elbow.TgtTagNode.Refresh(); }
    }

    // Tools -> Auto-Label Connections: labels every connection that has a cable type with a
    // prefix, numbering per prefix from 1 (e.g. DATA-1, DATA-2). Numbered in cable-schedule
    // order (by source device then source port) so the labels match the schedule. Connections
    // with no cable type / no prefix are left untouched. Regenerates on each run; the labels
    // are ordinary labels the user can still edit or move afterward.
    private void AutoLabelConnections()
    {
        var links = _diagram.Links.OfType<ElbowLinkModel>()
            .Where(l => l.Source.Model is PortModel && l.Target?.Model is PortModel)
            .OrderBy(l => (l.Source.Model as LineFlowPort)?.Parent.Title, StringComparer.OrdinalIgnoreCase)
            .ThenBy(l =>
            {
                var p = l.Source.Model as LineFlowPort;
                return p != null ? p.Parent.Ports.ToList().IndexOf(p) : 0;
            })
            .ToList();

        string? PrefixFor(ElbowLinkModel l) =>
            _cableTypes.FirstOrDefault(c => c.Name == l.CableTypeName)?.Prefix?.Trim();

        if (!links.Any(l => !string.IsNullOrEmpty(PrefixFor(l)))) return;

        PushUndoSnapshot();
        var counters = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var link in links)
        {
            var prefix = PrefixFor(link);
            if (string.IsNullOrEmpty(prefix)) continue;
            int n = counters.TryGetValue(prefix, out var last) ? last + 1 : 1;
            counters[prefix] = n;
            ApplyLabelToLink(link, $"{prefix}-{n}");
        }
    }

    // Best-effort midpoint of the link's current route, for placing a freshly-created label.
    // Falls back to the node midpoint if port positions aren't measured yet (e.g. right after
    // a bulk file load, before the first render pass).
    private Point ComputeLinkMidpoint(ElbowLinkModel elbow)
    {
        var route = new ElbowRouter().GetRoute(_diagram, elbow);
        double totalLength = 0;
        for (int i = 0; i < route.Length - 1; i++)
            totalLength += Math.Sqrt(Math.Pow(route[i + 1].X - route[i].X, 2) + Math.Pow(route[i + 1].Y - route[i].Y, 2));

        // A zero-length "route" means the ports haven't been measured by the browser yet
        // (freshly created PortModel.Position defaults to (0,0) rather than null) — fall
        // through to the node-midpoint estimate below instead of anchoring on (0,0).
        if (route.Length >= 2 && totalLength > 0.01)
        {
            double target = totalLength / 2;
            double covered = 0;
            for (int i = 0; i < route.Length - 1; i++)
            {
                double segLen = Math.Sqrt(Math.Pow(route[i + 1].X - route[i].X, 2) + Math.Pow(route[i + 1].Y - route[i].Y, 2));
                if (segLen <= 0) continue;
                if (covered + segLen >= target)
                {
                    double t = (target - covered) / segLen;
                    return new Point(route[i].X + (route[i + 1].X - route[i].X) * t, route[i].Y + (route[i + 1].Y - route[i].Y) * t);
                }
                covered += segLen;
            }
            return route[^1];
        }

        var srcNode = (elbow.Source.Model as PortModel)?.Parent;
        var tgtNode = (elbow.Target?.Model as PortModel)?.Parent;
        if (srcNode != null && tgtNode != null)
            return new Point((srcNode.Position.X + tgtNode.Position.X) / 2, (srcNode.Position.Y + tgtNode.Position.Y) / 2);
        return new Point(0, 0);
    }

    private void PushUndoSnapshot() => PushUndoSnapshot(SerializeDiagramState());

    private void PushUndoSnapshot(string snapshot)
    {
        if (_restoringState) return;
        _undoStack.Add(snapshot);
        if (_undoStack.Count > MaxUndoDepth) _undoStack.RemoveAt(0);
        _redoStack.Clear();
        MarkDirty();
    }

    // Tracks whether the canvas differs from the last Save/Open/New. Mirrored to a JS flag
    // so the beforeunload handler in index.html can warn before the tab closes. This is a
    // conservative flag (an edit-then-undo-back leaves it set) — we prefer a false "unsaved"
    // warning over silently losing work.
    private void MarkDirty()
    {
        if (_isDirty) return;
        _isDirty = true;
        _ = JS.InvokeVoidAsync("setUnsavedChanges", true);
    }

    private void MarkClean()
    {
        _isDirty = false;
        _ = JS.InvokeVoidAsync("setUnsavedChanges", false);
    }

    private void Undo()
    {
        if (_undoStack.Count == 0) return;
        var snapshot = _undoStack[^1];
        _undoStack.RemoveAt(_undoStack.Count - 1);
        _redoStack.Add(SerializeDiagramState());
        RestoreDiagramState(snapshot);
    }

    private void Redo()
    {
        if (_redoStack.Count == 0) return;
        var snapshot = _redoStack[^1];
        _redoStack.RemoveAt(_redoStack.Count - 1);
        _undoStack.Add(SerializeDiagramState());
        RestoreDiagramState(snapshot);
    }

    private void RestoreDiagramState(string json)
    {
        _restoringState = true;
        try
        {
            _pendingPointerSnapshot = null;
            LoadDiagramJson(json);
        }
        finally { _restoringState = false; }
        MarkDirty();
        InvokeAsync(StateHasChanged);
    }

    // --- Sheet operations (tab bar under the canvas) ---

    // Serializes the live canvas + undo history into the active Sheet record.
    private void ParkActiveSheet()
    {
        var s = _sheets[_activeSheetIndex];
        s.Json = SerializeDiagramState();
        s.UndoStack.Clear(); s.UndoStack.AddRange(_undoStack);
        s.RedoStack.Clear(); s.RedoStack.AddRange(_redoStack);
    }

    // Loads a parked sheet into the live canvas. The shared cable types survive the swap:
    // LoadDiagramJson replaces them from whatever the sheet JSON embeds (or clears them
    // when absent), so the document-wide set is restored afterwards and links recolored.
    private void ActivateSheet(int index)
    {
        _activeSheetIndex = index;
        var s = _sheets[index];
        var sharedTypes = _cableTypes.ToList();
        _pendingPointerSnapshot = null;
        _restoringState = true;
        try { LoadDiagramJson(s.Json ?? EmptySheetJson); }
        finally { _restoringState = false; }
        _cableTypes.Clear();
        _cableTypes.AddRange(sharedTypes);
        RefreshAllLinkColors();
        _undoStack.Clear(); _undoStack.AddRange(s.UndoStack);
        _redoStack.Clear(); _redoStack.AddRange(s.RedoStack);
        s.Json = null; s.UndoStack.Clear(); s.RedoStack.Clear();
    }

    private void SwitchSheet(int index)
    {
        if (index == _activeSheetIndex || index < 0 || index >= _sheets.Count) return;
        _renamingSheetIndex = -1;
        ParkActiveSheet();
        ActivateSheet(index);
        StateHasChanged();
    }

    private void AddSheet()
    {
        _renamingSheetIndex = -1;
        ParkActiveSheet();
        _sheets.Add(new Sheet { Name = NextSheetName() });
        ActivateSheet(_sheets.Count - 1);
        MarkDirty();
    }

    private string NextSheetName()
    {
        for (int n = _sheets.Count + 1; ; n++)
        {
            var name = $"Sheet {n}";
            if (!_sheets.Any(s => s.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
                return name;
        }
    }

    private async Task DeleteSheet(int index)
    {
        if (_sheets.Count <= 1 || index < 0 || index >= _sheets.Count) return;
        var name = _sheets[index].Name;
        if (!await JS.InvokeAsync<bool>("confirm", $"Delete sheet \"{name}\" and everything on it? This cannot be undone."))
            return;
        _renamingSheetIndex = -1;
        if (index == _activeSheetIndex)
        {
            _sheets.RemoveAt(index);
            ActivateSheet(Math.Max(0, index - 1));
        }
        else
        {
            _sheets.RemoveAt(index);
            if (index < _activeSheetIndex) _activeSheetIndex--;
        }
        MarkDirty();
        StateHasChanged();
    }

    private void StartRenameSheet(int index)
    {
        _renamingSheetIndex = index;
        _renameSheetText = _sheets[index].Name;
    }

    private void CommitRenameSheet()
    {
        if (_renamingSheetIndex >= 0 && _renamingSheetIndex < _sheets.Count)
        {
            var name = _renameSheetText.Trim();
            if (name.Length > 0 && name != _sheets[_renamingSheetIndex].Name)
            {
                _sheets[_renamingSheetIndex].Name = name;
                MarkDirty();
            }
        }
        _renamingSheetIndex = -1;
    }

    // Drag-style edits (node moves, bend drags, resizes, text edits) capture a snapshot
    // when the gesture starts and commit it as an undo step only if the diagram actually
    // changed by the time the gesture ends.
    public void CapturePointerSnapshot()
    {
        if (_restoringState) return;
        _pendingPointerSnapshot = SerializeDiagramState();
    }

    public void CommitPointerSnapshot()
    {
        if (_pendingPointerSnapshot == null) return;
        var pending = _pendingPointerSnapshot;
        _pendingPointerSnapshot = null;
        if (SerializeDiagramState() != pending)
            PushUndoSnapshot(pending);
    }

    private void OnDiagramPointerDown(Model? model, Blazor.Diagrams.Core.Events.PointerEventArgs args)
    {
        // Clicking empty canvas dismisses a live signal trace.
        if (args.Button == 0 && model == null)
            ClearTrace();

        if (args.Button == 0 && model is NodeModel or BaseLinkModel or LinkVertexModel)
            CapturePointerSnapshot();

        if (args.Button == 2)
        {
            // A tag block or its stub stands in for the (invisible) broken connection —
            // right-clicking either opens the connection's own menu (Rejoin, Label, …).
            if (model is BreakTagNode tag && tag.OwnerLink != null)
            {
                _contextTarget = "link";
                _contextLink = tag.OwnerLink;
                _contextNode = null;
                ShowContextMenu(args.ClientX, args.ClientY);
            }
            else if (model is BreakStubLink stub && stub.Owner != null)
            {
                _contextTarget = "link";
                _contextLink = stub.Owner;
                _contextNode = null;
                ShowContextMenu(args.ClientX, args.ClientY);
            }
            else if (model is NodeModel node)
            {
                _contextTarget = "node";
                _contextNode = node;
                _contextLink = null;
                ShowContextMenu(args.ClientX, args.ClientY);
            }
            else if (model is BaseLinkModel link)
            {
                _contextTarget = "link";
                _contextLink = link;
                _contextNode = null;
                ShowContextMenu(args.ClientX, args.ClientY);
            }
        }
    }

    // --- Signal path trace (right-click → 🔦 Trace Signal Path) ---
    // Pure view state: the traced set brightens/thickens while everything else dims.
    // Never serialized, never on the undo stack; cleared on any diagram rebuild.

    private readonly HashSet<NodeModel> _tracedNodes = new();
    private readonly HashSet<ElbowLinkModel> _tracedLinks = new();
    private bool TraceActive => _tracedNodes.Count > 0 || _tracedLinks.Count > 0;

    // Walks the connection graph from a device or connection: every device and connection
    // electrically reachable from the start is part of the path. Broken connections are
    // still single logical links, so a trace flows straight through them (and lights
    // their tag blocks).
    private void TraceSignalPath(object start)
    {
        _tracedNodes.Clear();
        _tracedLinks.Clear();

        var queue = new Queue<LineFlowNode>();
        void Visit(NodeModel? n) { if (n is LineFlowNode d && _tracedNodes.Add(d)) queue.Enqueue(d); }

        if (start is ElbowLinkModel firstLink)
        {
            _tracedLinks.Add(firstLink);
            Visit((firstLink.Source.Model as PortModel)?.Parent);
            Visit((firstLink.Target?.Model as PortModel)?.Parent);
        }
        else if (start is LineFlowNode firstNode)
        {
            Visit(firstNode);
        }

        while (queue.Count > 0)
        {
            var device = queue.Dequeue();
            foreach (var link in _diagram.Links.OfType<ElbowLinkModel>())
            {
                if (link.Source.Model is not PortModel sp || link.Target?.Model is not PortModel tp) continue;
                if (sp.Parent != device && tp.Parent != device) continue;
                _tracedLinks.Add(link);
                Visit(sp.Parent);
                Visit(tp.Parent);
            }
        }

        ApplyTraceVisuals();
    }

    public void ClearTrace()
    {
        if (!TraceActive) return;
        _tracedNodes.Clear();
        _tracedLinks.Clear();
        ApplyTraceVisuals();
    }

    // --- Per-device label (right-click a device -> Device Label) ---
    private bool _deviceLabelModalOpen;
    private NodeModel? _deviceLabelTarget;
    private string _deviceLabelText = "";

    private void OpenDeviceLabel()
