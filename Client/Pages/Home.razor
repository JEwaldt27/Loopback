    // --- Bulk device recolor (Tools -> Device Colors) ---
    private void OpenDeviceColors() => _deviceColorModalOpen = true;
    private void CloseDeviceColors() => _deviceColorModalOpen = false;

    private bool _editingBulkColor;

    // Applies a color change to EVERY device block on the canvas, as one undo step.
    // Used by the instant transparent-all button.
    private void ApplyToAllDevices(Action<LineFlowNode> set)
    {
        var devices = _diagram.Nodes.OfType<LineFlowNode>().ToList();
        if (devices.Count == 0) return;
        PushUndoSnapshot();
        foreach (var n in devices)
        {
            set(n);
            n.Refresh();
        }
    }

    // Live bulk recolor: update every device on each 'input' as the picker is dragged, but
    // snapshot the undo state once (first input) and commit once on 'change' — so a single
    // bulk pick is one undo step across all devices.
    private void OnBulkColorInput(Action<LineFlowNode, string> set, ChangeEventArgs e)
    {
        var devices = _diagram.Nodes.OfType<LineFlowNode>().ToList();
        if (devices.Count == 0) return;
        if (!_editingBulkColor) { CapturePointerSnapshot(); _editingBulkColor = true; }
        var v = e.Value?.ToString() ?? "";
        foreach (var n in devices)
        {
            set(n, v);
            n.Refresh();
        }
    }

    private void EndBulkColorEdit()
    {
        _editingBulkColor = false;
        CommitPointerSnapshot();
    }

    // Shows the first device's current color in a picker (falls back to a default when the
    // value is "transparent", which the native color input can't represent).
    private string FirstDeviceColor(Func<LineFlowNode, string> pick, string fallback)
    {
        var first = _diagram.Nodes.OfType<LineFlowNode>().FirstOrDefault();
        var c = first == null ? fallback : pick(first);
        return string.Equals(c, "transparent", StringComparison.OrdinalIgnoreCase) ? fallback : c;
    }

    private void SetAllFillTransparent() => ApplyToAllDevices(n => n.BackgroundColor = "transparent");

    // --- Cable types (right-side panel + per-connection assignment) ---

    // Sets a link's color from its assigned cable type (neutral gray if unassigned/unknown).
    // A broken connection draws no full line — its stroke is transparent; the visible stubs
    // + tags render in the device-node widget instead.
    private void ApplyCableColor(ElbowLinkModel link)
    {
        var visColor = CableColorFor(link);
        // While a trace is live, connections off the path fade to near-transparent.
        if (TraceActive && !_tracedLinks.Contains(link))
            visColor = DimColor(visColor);

        // Keep the broken-state visuals (tag blocks + stubs) on the cable color too.
        if (link.SrcTagNode != null) { link.SrcTagNode.Color = visColor; link.SrcTagNode.Refresh(); }
        if (link.TgtTagNode != null) { link.TgtTagNode.Color = visColor; link.TgtTagNode.Refresh(); }
        if (link.SrcStub != null) { link.SrcStub.Color = visColor; link.SrcStub.SelectedColor = visColor; link.SrcStub.Refresh(); }
        if (link.TgtStub != null) { link.TgtStub.Color = visColor; link.TgtStub.SelectedColor = visColor; link.TgtStub.Refresh(); }

        if (link.IsBroken)
        {
            link.Color = "transparent";
            link.SelectedColor = "transparent";
            return;
        }
        link.Color = visColor;
        link.SelectedColor = visColor;
    }

    // The on-screen color for a link's cable type (used for stubs, which stay colored even
    // though the broken link's own stroke is transparent).
    private string CableColorFor(ElbowLinkModel link)
        => _cableTypes.FirstOrDefault(c => c.Name == link.CableTypeName)?.Color ?? NeutralLinkColor;

    private void RefreshAllLinkColors()
    {
        foreach (var link in _diagram.Links.OfType<ElbowLinkModel>())
        {
            ApplyCableColor(link);
            link.Refresh();
        }
    }

    private void AddCableType()
    {
        var name = _newCableTypeName.Trim();
        if (string.IsNullOrEmpty(name)) return;
        if (_cableTypes.Any(c => c.Name.Equals(name, StringComparison.OrdinalIgnoreCase))) return;
        PushUndoSnapshot();
        _cableTypes.Add(new CableType
        {
            Name = name,
            Color = _newCableTypeColor,
            Prefix = _newCableTypePrefix.Trim(),
            PartNumber = _newCableTypePartNumber.Trim(),
            CableColor = _newCableTypeCableColor.Trim()
        });
        _newCableTypeName = "";
        _newCableTypePrefix = "";
        _newCableTypePartNumber = "";
        _newCableTypeCableColor = "";
    }

    private void OnCableTypeKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddCableType();
    }

    // Generic text-field editor for a cable type (prefix / part number / cable color).
    private void OnCableFieldChanged(CableType ct, Action<CableType, string> set, ChangeEventArgs e)
    {
        var v = (e.Value?.ToString() ?? "").Trim();
        PushUndoSnapshot();
        set(ct, v);
    }

    private void DeleteCableType(CableType ct)
    {
        PushUndoSnapshot();
        _cableTypes.Remove(ct);
        // Unassign any links that used it, so they fall back to the neutral color.
        foreach (var link in _diagram.Links.OfType<ElbowLinkModel>().Where(l => l.CableTypeName == ct.Name))
            link.CableTypeName = null;
        RefreshAllLinkColors();
    }

    // Live color edit of a cable type: recolors every link using it as one undo step.
    private void OnCableColorInput(CableType ct, ChangeEventArgs e)
