        _deviceLabelModalOpen = false;
        _deviceLabelTarget = null;
        _deviceLabelText = "";
    }

    private void SaveDeviceLabel()
    {
        if (_deviceLabelTarget is LineFlowNode device)
        {
            var text = _deviceLabelText.Trim();
            if (text != device.Label)
            {
                PushUndoSnapshot();
                device.Label = text;
                device.Refresh();
            }
        }
        CloseDeviceLabel();
    }

    private void RemoveDeviceLabel()
    {
