        CloseDeviceLabel();
    }

    private void TraceContextNode()
    {
        _contextMenuVisible = false;
        if (_contextNode is LineFlowNode device) TraceSignalPath(device);
        _contextNode = null;
    }

    private void TraceContextLink()
    {
        _contextMenuVisible = false;
        if (_contextLink is ElbowLinkModel link) TraceSignalPath(link);
        _contextLink = null;
    }

    // Recolors every connection (ApplyCableColor knows about the trace) and re-renders
    // every node so the widgets pick up their glow/dim classes.
    private void ApplyTraceVisuals()
    {
        foreach (var link in _diagram.Links.OfType<ElbowLinkModel>())
        {
            link.Width = TraceActive && _tracedLinks.Contains(link) ? 5 : 2;
            ApplyCableColor(link);
            link.Refresh();
        }
        foreach (var node in _diagram.Nodes)
            node.Refresh();
        StateHasChanged();
    }

    // Widget hooks: glow the traced devices, fade everything else while a trace is live.
    public string TraceClassFor(NodeModel node) =>
        !TraceActive ? "" : _tracedNodes.Contains(node) ? "lf-node-traced" : "lf-node-dimmed";

    public string TraceClassForLink(ElbowLinkModel? owner) =>
        !TraceActive ? "" : owner != null && _tracedLinks.Contains(owner) ? "" : "lf-trace-dim";

    // #rrggbb → mostly-transparent rgba for the dimmed connections.
    private static string DimColor(string color)
    {
        if (color.Length == 7 && color[0] == '#'
            && int.TryParse(color.AsSpan(1), System.Globalization.NumberStyles.HexNumber, null, out var rgb))
            return $"rgba({(rgb >> 16) & 0xFF},{(rgb >> 8) & 0xFF},{rgb & 0xFF},0.15)";
        return "rgba(128,128,128,0.15)";
    }

    // --- Connection "break": two label blocks + stub connections drawn to them ---

    private bool _removingBreakVisuals;
    private bool _loadingDiagram;

    private void SetLinkBroken(ElbowLinkModel link, bool broken)
    {
        link.IsBroken = broken;
        ApplyCableColor(link);   // transparent line when broken, cable color when rejoined
        if (broken) { StashVertices(link); CreateBreakVisuals(link); }
        else { RemoveBreakVisuals(link); RestoreVertices(link); }
        link.Refresh();
        link.LabelNode?.Refresh();   // center label hides while broken, returns on rejoin
    }

    // Park/unpark a link's bends around the broken state so their grab handles don't
    // render as stray dots along the invisible line.
    private static void StashVertices(ElbowLinkModel link)
    {
        if (link.Vertices.Count == 0) return;
        link.StashedVertices = link.Vertices.Select(v => v.Position).ToList();
        link.Vertices.Clear();
    }

    private static void RestoreVertices(ElbowLinkModel link)
    {
        if (link.StashedVertices is { Count: > 0 } saved)
            foreach (var p in saved)
                link.Vertices.Add(new LinkVertexModel(link, p));
        link.StashedVertices = null;
    }

    // Builds the broken-connection visuals: an identical tag block at each end plus a
    // locked stub connection from each port to its block.
    private void CreateBreakVisuals(ElbowLinkModel link, Point? srcPos = null, Point? tgtPos = null)
    {
        if (link.SrcTagNode != null || link.TgtTagNode != null) return;
        if (link.Source.Model is not PortModel srcPort || link.Target?.Model is not PortModel tgtPort) return;

        var color = CableColorFor(link);
        var text = link.LabelText ?? "";

        link.SrcTagNode = AddBreakTag(link, true, srcPos ?? DefaultTagPosition(srcPort, text), text, color);
        link.TgtTagNode = AddBreakTag(link, false, tgtPos ?? DefaultTagPosition(tgtPort, text), text, color);
        link.SrcStub = AddBreakStub(link, srcPort, link.SrcTagNode, color);
        link.TgtStub = AddBreakStub(link, tgtPort, link.TgtTagNode, color);
    }

    private BreakTagNode AddBreakTag(ElbowLinkModel link, bool isSource, Point pos, string text, string color)
    {
        var tag = new BreakTagNode(pos) { Text = text, Color = color, OwnerLink = link, IsSource = isSource };
        _diagram.Nodes.Add(tag);
        return tag;
    }

    private BreakStubLink AddBreakStub(ElbowLinkModel owner, PortModel port, BreakTagNode tag, string color)
    {
        var stub = new BreakStubLink(
            new Blazor.Diagrams.Core.Anchors.SinglePortAnchor(port),
            new Blazor.Diagrams.Core.Anchors.ShapeIntersectionAnchor(tag))
        {
            Owner = owner,
            Color = color,
            SelectedColor = color,
            Locked = true,
        };
        _diagram.Links.Add(stub);
        return stub;
    }

    private void RemoveBreakVisuals(ElbowLinkModel link)
    {
        if (_removingBreakVisuals) return;
        _removingBreakVisuals = true;
        try
        {
            if (link.SrcStub != null) _diagram.Links.Remove(link.SrcStub);
            if (link.TgtStub != null) _diagram.Links.Remove(link.TgtStub);
            if (link.SrcTagNode != null) _diagram.Nodes.Remove(link.SrcTagNode);
            if (link.TgtTagNode != null) _diagram.Nodes.Remove(link.TgtTagNode);
        }
        finally
        {
            link.SrcStub = link.TgtStub = null;
            link.SrcTagNode = link.TgtTagNode = null;
            _removingBreakVisuals = false;
        }
    }

    // Default spot for a fresh tag block: just outside its port, stepped a little further
    // out for each block already sitting on the same side of the same device so new tags
    // start clear of each other. They're ordinary nodes — drag them anywhere after.
    private Point DefaultTagPosition(PortModel port, string text)
    {
        double cx = (port.Position?.X ?? port.Parent.Position.X) + (port.Size?.Width / 2 ?? 0);
        double cy = (port.Position?.Y ?? port.Parent.Position.Y + 40) + (port.Size?.Height / 2 ?? 0);
        bool left = port.Alignment == PortAlignment.Left;
        int stagger = _diagram.Nodes.OfType<BreakTagNode>()
            .Count(t => TagPort(t) is { } p && p.Parent == port.Parent && p.Alignment == port.Alignment);
        double gap = 46 + 26 * stagger;
        double estW = 18 + 6.5 * text.Length;   // rough block width, for left-side placement only
        return new Point(left ? cx - gap - estW : cx + gap, cy - 10);
    }

    private static PortModel? TagPort(BreakTagNode tag) =>
        tag.OwnerLink == null ? null
        : tag.IsSource ? tag.OwnerLink.Source.Model as PortModel
        : tag.OwnerLink.Target?.Model as PortModel;

    private void ToggleBreakContextLink()
    {
        _contextMenuVisible = false;
        if (_contextLink is not ElbowLinkModel elbow) { _contextLink = null; return; }
        if (elbow.IsBroken)
        {
            PushUndoSnapshot();
            SetLinkBroken(elbow, false);
        }
        else if (string.IsNullOrEmpty(elbow.LabelText))
        {
            // A broken connection needs a tag — open the label modal, break once it's saved.
            _breakAfterLabel = true;
            _labelTargetLink = elbow;
            _labelText = "";
            _labelModalOpen = true;
        }
        else
        {
            PushUndoSnapshot();
            SetLinkBroken(elbow, true);
        }
        _contextLink = null;
    }

    // Tools -> Clear Connection Labels: strips every cable tag on this sheet, the counterpart
    // to Auto-Label. Confirms with a count first, since a label can be hand-typed work rather
    // than something auto-generated; it's a single undo step either way.
    private async Task ClearConnectionLabels()
    {
        var labeled = _diagram.Links.OfType<ElbowLinkModel>()
            .Where(l => !string.IsNullOrEmpty(l.LabelText)).ToList();
        if (labeled.Count == 0) return;

        var broken = labeled.Count(l => l.IsBroken);
        var warning = broken > 0
            ? $"\n\n{broken} of them are broken connections — their label blocks will be left blank."
            : "";
        if (!await JS.InvokeAsync<bool>("confirm",
                $"Clear {labeled.Count} connection label{(labeled.Count == 1 ? "" : "s")} on this sheet?{warning}\n\nUndo will bring them back."))
            return;

        PushUndoSnapshot();
        foreach (var link in labeled) RemoveLabelNode(link);
        StateHasChanged();
    }

    // Tools -> Break All: auto-label everything, then break every labeled connection.
    private void BreakAllConnections()
    {
        AutoLabelConnections();   // fills in prefix tags where a cable type has one
        var toBreak = _diagram.Links.OfType<ElbowLinkModel>()
            .Where(l => !l.IsBroken && !string.IsNullOrEmpty(l.LabelText)).ToList();
        if (toBreak.Count == 0) return;
        PushUndoSnapshot();
        foreach (var l in toBreak) SetLinkBroken(l, true);
    }

    private void RejoinAllConnections()
    {
        var broken = _diagram.Links.OfType<ElbowLinkModel>().Where(l => l.IsBroken).ToList();
        if (broken.Count == 0) return;
        PushUndoSnapshot();
        foreach (var l in broken) SetLinkBroken(l, false);
    }

    // --- Align / distribute the selected blocks (Tools menu) ---

    private List<NodeModel> SelectedNodes() => _diagram.Nodes.Where(n => n.Selected).ToList();

    private void AlignSelected(string edge)
    {
        var nodes = SelectedNodes();
        if (nodes.Count < 2) return;
        PushUndoSnapshot();
        double W(NodeModel n) => n.Size?.Width ?? 0;
        double H(NodeModel n) => n.Size?.Height ?? 0;
        switch (edge)
        {
            case "left":
                double minX = nodes.Min(n => n.Position.X);
                foreach (var n in nodes) n.SetPosition(minX, n.Position.Y);
                break;
            case "right":
                double maxR = nodes.Max(n => n.Position.X + W(n));
                foreach (var n in nodes) n.SetPosition(maxR - W(n), n.Position.Y);
                break;
            case "top":
                double minY = nodes.Min(n => n.Position.Y);
                foreach (var n in nodes) n.SetPosition(n.Position.X, minY);
                break;
            case "bottom":
                double maxB = nodes.Max(n => n.Position.Y + H(n));
                foreach (var n in nodes) n.SetPosition(n.Position.X, maxB - H(n));
                break;
        }
        foreach (var n in nodes) n.Refresh();
    }

    // Spreads the middle blocks so all selected centers are evenly spaced between the
    // outermost two (which stay put).
    private void DistributeSelected(bool horizontal)
    {
        var nodes = SelectedNodes();
        if (nodes.Count < 3) return;
        PushUndoSnapshot();
        double Cx(NodeModel n) => n.Position.X + (n.Size?.Width ?? 0) / 2;
        double Cy(NodeModel n) => n.Position.Y + (n.Size?.Height ?? 0) / 2;
        var ordered = (horizontal ? nodes.OrderBy(Cx) : nodes.OrderBy(Cy)).ToList();
        double first = horizontal ? Cx(ordered[0]) : Cy(ordered[0]);
        double last = horizontal ? Cx(ordered[^1]) : Cy(ordered[^1]);
        double step = (last - first) / (ordered.Count - 1);
        for (int i = 1; i < ordered.Count - 1; i++)
        {
            var n = ordered[i];
            double target = first + step * i;
            if (horizontal) n.SetPosition(target - (n.Size?.Width ?? 0) / 2, n.Position.Y);
            else n.SetPosition(n.Position.X, target - (n.Size?.Height ?? 0) / 2);
        }
        foreach (var n in nodes) n.Refresh();
    }

    // Arrow-key nudge: 1px per press, 10px with Shift. A burst of presses lands on the
    // undo stack as a single step.
    private DateTime _lastNudgeUtc = DateTime.MinValue;

    private void NudgeSelection(double dx, double dy)
    {
        var nodes = SelectedNodes();
        if (nodes.Count == 0) return;
        if (DateTime.UtcNow - _lastNudgeUtc > TimeSpan.FromSeconds(1.5))
            PushUndoSnapshot();
        _lastNudgeUtc = DateTime.UtcNow;
        foreach (var n in nodes)
        {
            n.SetPosition(n.Position.X + dx, n.Position.Y + dy);
            n.Refresh();
        }
    }

