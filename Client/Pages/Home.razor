@page "/"
@implements IDisposable
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav
@using System.Text.Json
@using Microsoft.JSInterop

<div class="toolbar">
    <span class="app-title">Loopback</span>
    <span class="lf-version" title="Running build version">@($"v{AppVersion.Version}")</span>

    <div class="lf-menu-root">
        <button class="lf-menu-btn @(_openMenu == "file" ? "lf-menu-btn-active" : "")" @onclick='() => ToggleMenu("file")'>File</button>
        @if (_openMenu == "file")
        {
            <div class="lf-dropdown-menu">
                <div class="lf-dropdown-item" @onclick="async () => { CloseMenus(); await NewDiagram(); }">🆕 New</div>
                <div class="lf-dropdown-item" @onclick="async () => { await SaveDiagram(); CloseMenus(); }">💾 Save</div>
                <label class="lf-dropdown-item">
                    📂 Open <InputFile id="open-file-input" name="open-file-input" OnChange="async e => { await OpenDiagram(e); CloseMenus(); }" accept=".lf" />
                </label>
            </div>
        }
    </div>

    <div class="lf-menu-root">
        <button class="lf-menu-btn @(_openMenu == "tools" ? "lf-menu-btn-active" : "")" @onclick='() => ToggleMenu("tools")'>Tools</button>
        @if (_openMenu == "tools")
        {
            <div class="lf-dropdown-menu">
                <div class="lf-dropdown-item" @onclick="() => { AddLegend(); CloseMenus(); }">🏷 Legend</div>
                <div class="lf-dropdown-item @(_placementMode == "box" ? "lf-dropdown-item-active" : "")" @onclick='() => { TogglePlacement("box"); CloseMenus(); }'>▭ Box</div>
                <div class="lf-dropdown-item @(_placementMode == "line" ? "lf-dropdown-item-active" : "")" @onclick='() => { TogglePlacement("line"); CloseMenus(); }'>╱ Line</div>
                <div class="lf-dropdown-item @(_placementMode == "text" ? "lf-dropdown-item-active" : "")" @onclick='() => { TogglePlacement("text"); CloseMenus(); }'>T Text</div>
                @* Checkbox glyph in BOTH states — with only a ✓-when-on it didn't read as a
                   toggle at all, and got missed. *@
                <div class="lf-dropdown-item @(_connectionsOnTop ? "lf-dropdown-item-active" : "")"
                     title="Raise connections above device blocks so you can grab a bend handle hidden under one"
                     @onclick="() => { _connectionsOnTop = !_connectionsOnTop; CloseMenus(); }">
                    @(_connectionsOnTop ? "☑" : "☐") 🔀 Connections On Top
                </div>
                <div class="lf-dropdown-item" @onclick="() => { OpenDeviceColors(); CloseMenus(); }">🎨 Device Colors…</div>
                <div class="lf-dropdown-item" @onclick="() => { _titleBlockModalOpen = true; CloseMenus(); }">📋 Title Block…</div>
                <div class="lf-dropdown-item" @onclick="() => { AutoLabelConnections(); CloseMenus(); }">🔢 Auto-Label Connections</div>
                <div class="lf-dropdown-item" @onclick="async () => { CloseMenus(); await ClearConnectionLabels(); }">🧹 Clear Connection Labels</div>
                <div class="lf-dropdown-item" @onclick="() => { BreakAllConnections(); CloseMenus(); }">🔗 Break All Connections</div>
                <div class="lf-dropdown-item" @onclick="() => { RejoinAllConnections(); CloseMenus(); }">🔗 Rejoin All Connections</div>
                <div class="lf-dropdown-sep"></div>
                <div class="lf-dropdown-item" @onclick='() => { AlignSelected("left"); CloseMenus(); }'>⇤ Align Left</div>
                <div class="lf-dropdown-item" @onclick='() => { AlignSelected("right"); CloseMenus(); }'>⇥ Align Right</div>
                <div class="lf-dropdown-item" @onclick='() => { AlignSelected("top"); CloseMenus(); }'>⤒ Align Top</div>
                <div class="lf-dropdown-item" @onclick='() => { AlignSelected("bottom"); CloseMenus(); }'>⤓ Align Bottom</div>
                <div class="lf-dropdown-item" @onclick="() => { DistributeSelected(true); CloseMenus(); }">↔ Distribute Horizontally</div>
                <div class="lf-dropdown-item" @onclick="() => { DistributeSelected(false); CloseMenus(); }">↕ Distribute Vertically</div>
            </div>
        }
    </div>

    <div class="lf-menu-root">
        <button class="lf-menu-btn @(_openMenu == "export" ? "lf-menu-btn-active" : "")" @onclick='() => ToggleMenu("export")'>Export</button>
        @if (_openMenu == "export")
        {
            <div class="lf-dropdown-menu">
                <div class="lf-dropdown-item" @onclick="async () => { await ExportPdf(); CloseMenus(); }">📄 Export PDF</div>
                <div class="lf-dropdown-item" @onclick="async () => { await ExportDxf(); CloseMenus(); }">📐 Export DXF</div>
                <div class="lf-dropdown-item" @onclick="async () => { await ExportCableSchedule(); CloseMenus(); }">🧾 Cable Schedule (CSV)</div>
                <div class="lf-dropdown-item" @onclick="async () => { await ExportDeviceSchedule(); CloseMenus(); }">📦 Device Schedule (CSV)</div>
            </div>
        }
    </div>

    <div class="lf-menu-root">
        <button class="lf-menu-btn @(_openMenu == "help" ? "lf-menu-btn-active" : "")" @onclick='() => ToggleMenu("help")'>Help</button>
        @if (_openMenu == "help")
        {
            <div class="lf-dropdown-menu">
                <a class="lf-dropdown-item lf-dropdown-link" href="https://github.com/JEwaldt27/Loopback/blob/master/UserGuide.md"
                   target="_blank" rel="noopener noreferrer" @onclick="CloseMenus">📖 User Guide</a>
            </div>
        }
    </div>

    <button class="lf-menu-btn" title="Suggest a feature or see what's been asked for"
            @onclick="OpenFeatureRequests">💡 Feature Requests</button>

    <button @onclick="Undo" disabled="@(!CanUndo)" title="Undo (Ctrl+Z)">↩ Undo</button>
    <button @onclick="Redo" disabled="@(!CanRedo)" title="Redo (Ctrl+Y)">↪ Redo</button>
    <button @onclick="DeleteSelected">Delete Selected</button>
    <input class="title-input" id="diagram-title" name="diagram-title" @bind="_diagramTitle" placeholder="Diagram title..." />
    @if (_isDirty)
    {
        <span class="lf-unsaved-badge" title="You have unsaved changes">● Unsaved</span>
    }

    <div class="lf-menu-root" style="margin-left:auto;">
        <button class="lf-menu-btn @(_openMenu == "account" ? "lf-menu-btn-active" : "")" @onclick='() => ToggleMenu("account")'>👤 @_currentUsername</button>
        @if (_openMenu == "account")
        {
            <div class="lf-dropdown-menu">
                <div class="lf-account-menu-user">@_currentUsername (@_currentRole)</div>
                @if (_currentRole == "Admin")
                {
                    <div class="lf-dropdown-item" @onclick='() => { CloseMenus(); Nav.NavigateTo("/users"); }'>👥 Manage Users</div>
                }
                <div class="lf-dropdown-item" @onclick="() => { OpenChangePassword(); CloseMenus(); }">🔑 Change Password</div>
                <div class="lf-dropdown-item" @onclick="async () => { await Logout(); CloseMenus(); }">🚪 Logout</div>
            </div>
        }
    </div>
</div>

@if (_openMenu != null)
{
    <div class="lf-menu-overlay" @onclick="CloseMenus"></div>
}

@if (!string.IsNullOrEmpty(_createdBy) || !string.IsNullOrEmpty(_modifiedBy))
{
    <div class="lf-file-meta">
        @if (!string.IsNullOrEmpty(_createdBy))
        {
            <span>Created by <strong>@_createdBy</strong>@(_createdAt is { } ca ? $" on {ca.ToLocalTime():MMM d, yyyy h:mm tt}" : "")</span>
        }
        @if (!string.IsNullOrEmpty(_modifiedBy))
        {
            <span> &middot; Last modified by <strong>@_modifiedBy</strong>@(_modifiedAt is { } ma ? $" on {ma.ToLocalTime():MMM d, yyyy h:mm tt}" : "")</span>
        }
    </div>
}

<div class="app-body" @onclick="HideContextMenu">
    <div class="side-panel">
        <div class="side-panel-header">Devices</div>

        <div class="lf-search-row">
            <input class="device-input lf-search-input" type="search" id="device-search" name="device-search"
                   placeholder="🔍 Search devices…" @bind="_deviceSearch" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_deviceSearch))
            {
                <button class="device-action-btn lf-search-clear" title="Clear search" @onclick='() => _deviceSearch = ""'>✕</button>
            }
        </div>

        <div class="lf-sort-row">
            <span class="lf-sort-label">Sort by</span>
            <select class="device-input lf-sort-select" id="device-sort-mode" name="device-sort-mode" @bind="_deviceSortMode">
                <option value="category">Type</option>
                <option value="manufacturer">Manufacturer</option>
            </select>
        </div>

        @if (!string.IsNullOrEmpty(_deviceSearch) && !GroupedDevices.Any())
        {
            <div class="cable-type-empty">No devices match "@_deviceSearch".</div>
        }

        @foreach (var group in GroupedDevices)
        {
            <div class="device-category">@group.Key</div>
            @foreach (var device in group)
            {
                var idx = _devices.IndexOf(device);
                <div class="device-item @(_placementMode == "device" && _placingDevice == device ? "device-item-active" : "")" draggable="true"
                     @ondragstart="() => OnDeviceDragStart(device)"
                     @onclick="() => ToggleDevicePlacement(device)">
                    <div class="device-item-model">@device.Model</div>
                    <div class="device-item-mfr">@device.Manufacturer</div>
                    <div class="device-item-actions">
                        <button class="device-action-btn" title="Duplicate device" @onclick:stopPropagation="true"
                                @onclick="() => DuplicateDevice(idx)">⧉</button>
                        <button class="device-action-btn" title="Edit device" @onclick:stopPropagation="true"
                                @onclick="() => StartEditDevice(idx)">✏</button>
                        <button class="device-action-btn device-action-delete" title="Delete device" @onclick:stopPropagation="true"
                                @onclick="() => DeleteDevice(idx)">🗑</button>
                    </div>
                </div>
            }
        }

        <button class="add-device-btn" style="margin-top:16px;" @onclick="OpenAddDeviceModal">+ Add Device</button>
    </div>

    <div class="canvas-column">
        <div class="canvas-area @(_placementMode != "" ? "canvas-placing" : "") @(_connectionsOnTop ? "lf-links-on-top" : "")"
             @ondragover:preventDefault="true"
             @ondrop="OnCanvasDrop"
             @onclick="OnCanvasClick"
             @onmousemove="OnCanvasMouseMove"
             @onmouseup="OnCanvasMouseUp"
             @oncontextmenu:preventDefault="true">
            <CascadingValue Value="this" IsFixed="true">
                <CascadingValue Value="_diagram">
                    <DiagramCanvas />
                </CascadingValue>
            </CascadingValue>
            @if (TraceActive)
            {
                <div class="lf-trace-chip" @onclick:stopPropagation="true">
                    🔦 Tracing signal path
                    <button class="lf-trace-clear" @onclick="ClearTrace" title="Clear trace (Esc)">✕ clear</button>
                </div>
            }
        </div>
        <div class="lf-sheet-bar">
            @for (int i = 0; i < _sheets.Count; i++)
            {
                var si = i;
                <div class="lf-sheet-tab @(si == _activeSheetIndex ? "lf-sheet-tab-active" : "")"
                     title="Double-click to rename"
                     @onclick="() => SwitchSheet(si)" @ondblclick="() => StartRenameSheet(si)">
                    @if (_renamingSheetIndex == si)
                    {
                        <input class="lf-sheet-rename" id="sheet-rename" name="sheet-rename"
                               @bind="_renameSheetText" @bind:event="oninput"
                               @onblur="CommitRenameSheet"
                               @onclick:stopPropagation="true"
                               @onkeydown='e => { if (e.Key == "Enter") CommitRenameSheet(); else if (e.Key == "Escape") _renamingSheetIndex = -1; }' />
                    }
                    else
                    {
                        <span class="lf-sheet-name">@_sheets[si].Name</span>
                        @if (_sheets.Count > 1)
                        {
                            <span class="lf-sheet-close" title="Delete sheet" @onclick:stopPropagation="true"
                                  @onclick="() => DeleteSheet(si)">✕</span>
                        }
                    }
                </div>
            }
            <button class="lf-sheet-add" title="Add sheet" @onclick="AddSheet">＋</button>
        </div>
    </div>

    <div class="cable-panel">
        <div class="side-panel-header">Cable Types</div>
        @if (_cableTypes.Count == 0)
        {
            <div class="cable-type-empty">No cable types yet. Add one below — you'll pick a type when you draw a connection.</div>
        }
        @foreach (var ct in _cableTypes)
        {
            <div class="cable-type-card">
                <div class="cable-type-row">
                    <input type="color" class="cable-type-swatch" value="@ct.Color"
                           @oninput="e => OnCableColorInput(ct, e)" @onchange="EndCableColorEdit" title="On-screen line color" />
                    <span class="cable-type-name" title="@ct.Name">@ct.Name</span>
                    <button class="device-action-btn device-action-delete" @onclick="() => DeleteCableType(ct)" title="Delete cable type">🗑</button>
                </div>
                <div class="cable-type-fields">
                    <input class="device-input cable-field-input" value="@ct.Prefix" placeholder="Prefix"
                           @onchange="e => OnCableFieldChanged(ct, (c, v) => c.Prefix = v, e)" title="Auto-label prefix (e.g. DATA → DATA-1)" />
                    <input class="device-input cable-field-input" value="@ct.PartNumber" placeholder="Part #"
                           @onchange="e => OnCableFieldChanged(ct, (c, v) => c.PartNumber = v, e)" title="Cable part number" />
                    <input class="device-input cable-field-input" value="@ct.CableColor" placeholder="Color"
                           @onchange="e => OnCableFieldChanged(ct, (c, v) => c.CableColor = v, e)" title="Physical cable/jacket color (text)" />
                </div>
            </div>
        }
        <div class="cable-type-add">
            <input class="device-input" placeholder="New cable type…" @bind="_newCableTypeName" @bind:event="oninput" @onkeydown="OnCableTypeKeyDown" />
            <input type="color" class="cable-type-swatch" @bind="_newCableTypeColor" title="On-screen line color" />
            <input class="device-input cable-field-input" placeholder="Prefix" @bind="_newCableTypePrefix" @bind:event="oninput" @onkeydown="OnCableTypeKeyDown" title="Auto-label prefix (optional)" />
            <input class="device-input cable-field-input" placeholder="Part #" @bind="_newCableTypePartNumber" @bind:event="oninput" @onkeydown="OnCableTypeKeyDown" title="Cable part number (optional)" />
            <input class="device-input cable-field-input" placeholder="Color" @bind="_newCableTypeCableColor" @bind:event="oninput" @onkeydown="OnCableTypeKeyDown" title="Physical cable color (optional)" />
            <button class="add-device-btn" @onclick="AddCableType">+ Add</button>
        </div>
    </div>

    @if (_contextMenuVisible)
    {
        <div class="context-menu" style="left:@(_contextMenuX)px; top:@(_contextMenuY)px;">
            @if (_contextTarget == "node")
            {
                @if (_contextNode is ConnectionLabelNode)
                {
                    <div class="context-menu-item" @onclick="RotateContextLabel">↻ Rotate Label 90°</div>
                }
                @if (_contextNode is LineFlowNode dev)
                {
                    <div class="context-menu-item" @onclick="OpenDeviceLabel">🏷 @(string.IsNullOrEmpty(dev.Label) ? "Add Device Label" : "Edit Device Label")</div>
                    <div class="context-menu-item" @onclick="TraceContextNode">🔦 Trace Signal Path</div>
                }
                <div class="context-menu-item" @onclick="DuplicateContextNode">⧉ Duplicate</div>
                <div class="context-menu-item" @onclick="DeleteContextNode">🗑 Delete Node</div>
            }
            @if (_contextTarget == "link")
            {
                @* Bends apply to the visible line, so hide them while the connection is broken. *@
                @if ((_contextLink as ElbowLinkModel)?.IsBroken != true)
                {
                    <div class="context-menu-item" @onclick="AddBend">➕ Add Bend</div>
                    @if (_contextLink is ElbowLinkModel elm && elm.Vertices.Count > 1)
                    {
                        <div class="context-menu-item" @onclick="RemoveLastBend">➖ Remove Last Bend</div>
                    }
                }
                <div class="context-menu-item" @onclick="TraceContextLink">🔦 Trace Signal Path</div>
                <div class="context-menu-item" @onclick="OpenCableTypeForContextLink">🔌 Cable Type…</div>
                <div class="context-menu-item" @onclick="ToggleBreakContextLink">🔗 @((_contextLink as ElbowLinkModel)?.IsBroken == true ? "Rejoin Connection" : "Break Connection")</div>
                <div class="context-menu-item" @onclick="OpenLabelModal">🏷 @(!string.IsNullOrEmpty((_contextLink as ElbowLinkModel)?.LabelText) ? "Edit Label" : "Add Label")</div>
                <div class="context-menu-item" @onclick="DeleteContextLink">🗑 Delete Connection</div>
            }
        </div>
    }
</div>

@if (_deviceModalOpen)
{
    <div class="lf-modal-overlay" @onclick="CancelEditDevice"></div>
    <div class="lf-modal" @onclick:stopPropagation="true">
        <div class="lf-modal-header">
            <span>@(_editingIndex >= 0 ? "Edit Device" : "Add Device")</span>
            <button class="lf-modal-close" @onclick="CancelEditDevice">✕</button>
        </div>

        <input class="device-input" id="new-device-manufacturer" name="new-device-manufacturer" @bind="_newManufacturer" placeholder="Manufacturer..." />
        <input class="device-input" id="new-device-model" name="new-device-model" @bind="_newModel" placeholder="Model number..." />
        <input class="device-input" id="new-device-category" name="new-device-category" @bind="_newCategory" placeholder="Category..." />

        <datalist id="lf-port-types">
            @foreach (var t in PortTypeSuggestions)
            {
                <option value="@t"></option>
            }
        </datalist>

        <div class="port-list-header">Ports</div>
        <div class="lf-port-hint">Signal type is free text — pick a suggestion or type a new one (e.g. Dante, AES67, Fiber).</div>
        @for (int i = 0; i < _newPorts.Count; i++)
        {
            var idx = i;
            <div class="port-row">
                <input class="port-input" id="@($"port-name-{idx}")" name="@($"port-name-{idx}")" @bind="_newPorts[idx].Name" placeholder="Name" />
                @* Free text with suggestions rather than a fixed dropdown: type anything and
                   it becomes a suggestion for everyone once the device is saved. *@
                <input class="port-select" list="lf-port-types" placeholder="Type"
                       id="@($"port-type-{idx}")" name="@($"port-type-{idx}")" @bind="_newPorts[idx].Type" />
                <select class="port-select" id="@($"port-direction-{idx}")" name="@($"port-direction-{idx}")" @bind="_newPorts[idx].Direction">
                    <option>In</option>
                    <option>Out</option>
                    <option>Universal</option>
                </select>
                <button class="port-remove-btn" @onclick="() => RemovePort(idx)">✕</button>
            </div>
        }
        <button class="add-port-btn" @onclick="AddPort">+ Add Port</button>

        @if (_editingIndex >= 0)
        {
            <button class="add-device-btn" @onclick="SaveEditDevice">✔ Update Device</button>
            <button class="add-device-btn" style="border-color:#888;margin-top:2px;" @onclick="CancelEditDevice">✕ Cancel</button>
        }
        else
        {
            <button class="add-device-btn" @onclick="AddDevice">+ Add Device</button>
        }
    </div>
}

@if (_labelModalOpen)
{
    <div class="lf-modal-overlay" @onclick="CloseLabelModal"></div>
    <div class="lf-modal" style="width:260px;" @onclick:stopPropagation="true">
        <div class="lf-modal-header">
            <span>Connection Label</span>
            <button class="lf-modal-close" @onclick="CloseLabelModal">✕</button>
        </div>
        <input class="device-input" id="connection-label-input" name="connection-label-input" @bind="_labelText" placeholder="e.g. VID-005" autofocus />
        <button class="add-device-btn" @onclick="SaveLabel">✔ Save</button>
        @if (!string.IsNullOrEmpty(_labelTargetLink?.LabelText))
        {
            <button class="add-device-btn" style="border-color:#888;margin-top:2px;" @onclick="RemoveLabel">🗑 Remove Label</button>
        }
    </div>
}

@if (_deviceLabelModalOpen)
{
    <div class="lf-modal-overlay" @onclick="CloseDeviceLabel"></div>
    <div class="lf-modal" style="width:280px;" @onclick:stopPropagation="true">
        <div class="lf-modal-header">
            <span>Device Label</span>
            <button class="lf-modal-close" @onclick="CloseDeviceLabel">✕</button>
        </div>
        <div class="lf-tb-hint">A tag for this specific unit, e.g. SW-1. Distinguishes two of the same model on the drawing and in the cable schedule.</div>
        <input class="device-input" id="device-label-input" name="device-label-input"
               @bind="_deviceLabelText" placeholder="e.g. SW-1" autofocus />
        <button class="add-device-btn" @onclick="SaveDeviceLabel">✔ Save</button>
        @if (!string.IsNullOrEmpty((_deviceLabelTarget as LineFlowNode)?.Label))
        {
            <button class="add-device-btn" style="border-color:#888;margin-top:2px;" @onclick="RemoveDeviceLabel">🗑 Remove Label</button>
        }
    </div>
}

@if (_featureModalOpen)
{
    <div class="lf-modal-overlay" @onclick="() => _featureModalOpen = false"></div>
    <div class="lf-modal lf-modal-wide" @onclick:stopPropagation="true">
        <div class="lf-modal-header">
            <span>Feature Requests</span>
            <button class="lf-modal-close" @onclick="() => _featureModalOpen = false">✕</button>
        </div>

        <textarea class="device-input lf-fr-input" rows="3" placeholder="What would you like Loopback to do?"
                  @bind="_newFeatureText" @bind:event="oninput"></textarea>
        <button class="add-device-btn" disabled="@(_featureBusy || string.IsNullOrWhiteSpace(_newFeatureText))"
                @onclick="SubmitFeatureRequest">@(_featureBusy ? "Sending…" : "➕ Submit Request")</button>
        @if (!string.IsNullOrEmpty(_featureError))
        {
            <div class="lf-tb-error">@_featureError</div>
        }

        <div class="lf-tb-section">@_featureRequests.Count request@(_featureRequests.Count == 1 ? "" : "s")</div>

        @if (_featureRequests.Count == 0)
        {
            <div class="cable-type-empty">Nothing yet — the first request is yours to make.</div>
        }

        @foreach (var fr in _featureRequests)
        {
            var r = fr;
            <div class="lf-fr-card">
                <div class="lf-fr-head">
                    <span class="lf-fr-badge lf-fr-@r.Status.ToLowerInvariant()">@r.Status</span>
                    <span class="lf-fr-meta">@r.CreatedBy · @r.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                    <span class="lf-fr-actions">
                        @if (CanEditRequest(r))
                        {
                            <button class="device-action-btn" title="Edit" @onclick="() => StartEditRequest(r)">✏</button>
                        }
                        @if (_currentRole == "Admin")
                        {
                            <button class="device-action-btn device-action-delete" title="Delete"
                                    @onclick="() => DeleteFeatureRequest(r)">🗑</button>
                        }
                    </span>
                </div>

                @if (_editingRequestId == r.Id)
                {
                    <textarea class="device-input lf-fr-input" rows="3" @bind="_editRequestText" @bind:event="oninput"></textarea>
                    <div class="lf-fr-editrow">
                        <button class="add-device-btn lf-fr-save" @onclick="() => SaveRequestText(r)">✔ Save</button>
                        <button class="add-device-btn lf-fr-cancel" @onclick="() => _editingRequestId = null">Cancel</button>
                    </div>
                }
                else
                {
                    <div class="lf-fr-text">@r.Text</div>
                }

                @if (_currentRole == "Admin")
                {
                    <div class="lf-fr-editrow">
                        <span class="lf-tb-hint">Status</span>
                        <select class="device-input lf-fr-status" value="@r.Status"
                                @onchange="e => SetRequestStatus(r, e.Value?.ToString())">
                            @foreach (var s in FeatureStatuses)
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                }
            </div>
        }
    </div>
}

@if (_titleBlockModalOpen)
{
    <div class="lf-modal-overlay" @onclick="CloseTitleBlock"></div>
    <div class="lf-modal lf-modal-wide" @onclick:stopPropagation="true">
        <div class="lf-modal-header">
            <span>Title Block</span>
            <button class="lf-modal-close" @onclick="CloseTitleBlock">✕</button>
        </div>

        <label class="lf-tb-check">
