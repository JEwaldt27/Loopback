@code {
    private BlazorDiagram _diagram = null!;
    private List<DeviceDefinition> _devices = new();
    private DeviceDefinition? _draggingDevice = null;
    private string _diagramTitle = "Line Flow Diagram";

    private string _newManufacturer = "";
    private string _newModel = "";
    private string _newCategory = "";
    private List<PortDefinition> _newPorts = new();
    private int _editingIndex = -1;
    private bool _deviceModalOpen = false;

    private bool _contextMenuVisible = false;
    private double _contextMenuX = 0;
    private double _contextMenuY = 0;
    private string _contextTarget = "";
    private NodeModel? _contextNode = null;
    private BaseLinkModel? _contextLink = null;

    private bool _labelModalOpen = false;
    private ElbowLinkModel? _labelTargetLink = null;
    private string _labelText = "";
    private bool _breakAfterLabel = false;   // break the link once its label is saved

    private bool _deviceColorModalOpen = false;

    // Per-diagram cable types (name + color). Persisted in the .lf file.
    private const string NeutralLinkColor = "#808080";
    private List<CableType> _cableTypes = new();
    private string _newCableTypeName = "";
    private string _newCableTypePrefix = "";
    private string _newCableTypePartNumber = "";
    private string _newCableTypeCableColor = "";
    private string _newCableTypeColor = "#4fc3f7";
    private bool _editingCableColor;

    private bool _cableTypePickerOpen = false;
    private ElbowLinkModel? _cableTypePickerLink = null;
    private bool _cableTypePickerIsNew = false;

    private bool _passwordModalOpen = false;
    private string _pwCurrent = "";
    private string _pwNew = "";
    private string _pwConfirm = "";
    private string _pwError = "";
    private string _pwSuccess = "";
    private bool _pwBusy = false;

    private string _placementMode = ""; // "", "box", "line", "text", "device"
    private DeviceDefinition? _placingDevice = null;
    private string? _openMenu = null; // null, "file", "tools", "export", "account"

    private readonly List<string> _undoStack = new();
    private readonly List<string> _redoStack = new();

    // --- Multi-sheet support ---
    // Each sheet is an independent canvas (devices, connections, annotations, legend, and
    // its own undo history); cable types, title, and file meta are shared document-wide.
    // Only the active sheet lives in _diagram — inactive sheets are parked as serialized
    // JSON, the same round-trip format undo/redo and .lf files already use.
    private class Sheet
    {
        public string Name { get; set; } = "Sheet 1";
        public string? Json { get; set; }              // parked state (null while active)
        // Title block fields that differ per sheet — everything else is document-wide.
        public string DrawingTitle { get; set; } = "";
        public string DrawingNumber { get; set; } = "";
        public List<string> UndoStack { get; } = new();
        public List<string> RedoStack { get; } = new();
    }

    // View-only toggle (Tools -> Connections On Top): raises the connections layer above the
    // device blocks so a bend handle sitting under one can be grabbed. Not saved with the
    // diagram — it's a working preference, not part of the drawing.
    private bool _connectionsOnTop;

    private TitleBlockInfo _titleBlock = new();
    private bool _titleBlockModalOpen;

    // --- Feature requests ---
    private static readonly string[] FeatureStatuses = { "Received", "WIP", "Done", "Declined" };

    private bool _featureModalOpen;
    private bool _featureBusy;
    private string _newFeatureText = "";
    private string _featureError = "";
    private List<FeatureRequestDto> _featureRequests = new();
    private string? _editingRequestId;
    private string _editRequestText = "";

    public class FeatureRequestDto
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
        public string Status { get; set; } = "Received";
        public string CreatedBy { get; set; } = "";
        public DateTimeOffset CreatedAt { get; set; }
    }

    // Mirrors the server rule: admins always; the author only while it's still Received.
    private bool CanEditRequest(FeatureRequestDto r) =>
        _currentRole == "Admin" ||
        (string.Equals(r.CreatedBy, _currentUsername, StringComparison.OrdinalIgnoreCase)
         && r.Status == "Received");

    private async Task OpenFeatureRequests()
    {
        _featureModalOpen = true;
        _featureError = "";
        _editingRequestId = null;
        await LoadFeatureRequests();
    }

    private async Task LoadFeatureRequests()
    {
        try
        {
            _featureRequests = await Http.GetFromJsonAsync<List<FeatureRequestDto>>("api/featurerequests") ?? new();
        }
        catch (Exception ex)
        {
            _featureError = "Couldn't load requests: " + ex.Message;
        }
    }

    private async Task SubmitFeatureRequest()
    {
        var text = _newFeatureText.Trim();
        if (string.IsNullOrWhiteSpace(text)) return;
        _featureBusy = true;
        _featureError = "";
        try
        {
            var res = await Http.PostAsJsonAsync("api/featurerequests", new { text });
            if (res.IsSuccessStatusCode) { _newFeatureText = ""; await LoadFeatureRequests(); }
            else _featureError = await ErrorTextAsync(res);
        }
        catch (Exception ex) { _featureError = ex.Message; }
        finally { _featureBusy = false; }
    }

    private void StartEditRequest(FeatureRequestDto r)
    {
        _editingRequestId = r.Id;
        _editRequestText = r.Text;
        _featureError = "";
    }

    private async Task SaveRequestText(FeatureRequestDto r)
    {
        _featureError = "";
        try
        {
            var res = await Http.PutAsJsonAsync($"api/featurerequests/{r.Id}", new { text = _editRequestText });
            if (res.IsSuccessStatusCode) { _editingRequestId = null; await LoadFeatureRequests(); }
            else _featureError = await ErrorTextAsync(res);
        }
        catch (Exception ex) { _featureError = ex.Message; }
    }

    private async Task SetRequestStatus(FeatureRequestDto r, string? status)
    {
        if (string.IsNullOrEmpty(status)) return;
        _featureError = "";
        try
        {
            var res = await Http.PutAsJsonAsync($"api/featurerequests/{r.Id}", new { status });
            if (res.IsSuccessStatusCode) await LoadFeatureRequests();
            else _featureError = await ErrorTextAsync(res);
        }
        catch (Exception ex) { _featureError = ex.Message; }
    }

    private async Task DeleteFeatureRequest(FeatureRequestDto r)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Delete this feature request?")) return;
        _featureError = "";
        try
        {
            var res = await Http.DeleteAsync($"api/featurerequests/{r.Id}");
            if (res.IsSuccessStatusCode) await LoadFeatureRequests();
            else _featureError = await ErrorTextAsync(res);
        }
        catch (Exception ex) { _featureError = ex.Message; }
    }

    // Surfaces the server's own message (permission refusals, length limits) rather than a
    // bare status code.
    private static async Task<string> ErrorTextAsync(HttpResponseMessage res)
    {
        try
        {
            var doc = JsonDocument.Parse(await res.Content.ReadAsStringAsync());
            if (doc.RootElement.TryGetProperty("error", out var e)) return e.GetString() ?? "Request failed.";
        }
        catch { }
        return $"Request failed ({(int)res.StatusCode}).";
    }

    // Title block logo. Server-side and shared across every diagram, so it lives outside
    // TitleBlockInfo (which is saved per .lf file) — see LogoController.
    private string? _logoDataUri;
    private string _logoError = "";
    private bool _logoBusy;

    private record LogoPayload(string DataUri);

    private async Task LoadLogo()
    {
        try
        {
            var res = await Http.GetAsync("api/logo");
            if (res.StatusCode == System.Net.HttpStatusCode.NoContent) { _logoDataUri = null; return; }
            if (res.IsSuccessStatusCode)
                _logoDataUri = (await res.Content.ReadFromJsonAsync<LogoPayload>())?.DataUri;
        }
        catch (Exception ex)
        {
            Console.WriteLine("Failed to load logo: " + ex.Message);
        }
    }

    private async Task UploadLogo(InputFileChangeEventArgs e)
    {
        _logoError = "";
        var file = e.File;
        if (file == null) return;

        const long max = 2 * 1024 * 1024;
        if (file.Size > max) { _logoError = "Image is too large — keep it under 2 MB."; return; }

        _logoBusy = true;
        try
        {
            using var stream = file.OpenReadStream(max);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
            var dataUri = $"data:{contentType};base64,{Convert.ToBase64String(ms.ToArray())}";

            var res = await Http.PostAsJsonAsync("api/logo", new { dataUri });
            if (res.IsSuccessStatusCode) _logoDataUri = dataUri;
            else _logoError = "Upload failed — the server rejected the image.";
        }
        catch (Exception ex) { _logoError = ex.Message; }
        finally { _logoBusy = false; }
    }

    private async Task RemoveLogo()
    {
        _logoError = "";
        try
        {
            await Http.DeleteAsync("api/logo");
            _logoDataUri = null;
        }
        catch (Exception ex) { _logoError = ex.Message; }
    }

    private const string EmptySheetJson = "{\"nodes\":[],\"links\":[]}";
    private List<Sheet> _sheets = new() { new Sheet() };
    private int _activeSheetIndex = 0;
    private int _renamingSheetIndex = -1;
    private string _renameSheetText = "";
    private const int MaxUndoDepth = 50;
    private string? _pendingPointerSnapshot = null;
    private bool _restoringState = false;
    private bool CanUndo => _undoStack.Count > 0;
    private bool CanRedo => _redoStack.Count > 0;
    private bool _isDirty = false; // unsaved changes since last Save/Open/New
    private string? _clipboardJson = null; // in-app clipboard for copy/paste of nodes
    private int _pasteSequence = 0; // grows per paste so repeats don't stack exactly
    private string _deviceSortMode = "category"; // "category" or "manufacturer"
    private string _deviceSearch = "";

    // Case-insensitive match against manufacturer, model, or category.
    private bool MatchesSearch(DeviceDefinition d) =>
        string.IsNullOrWhiteSpace(_deviceSearch)
        || d.Manufacturer.Contains(_deviceSearch, StringComparison.OrdinalIgnoreCase)
        || d.Model.Contains(_deviceSearch, StringComparison.OrdinalIgnoreCase)
        || d.Category.Contains(_deviceSearch, StringComparison.OrdinalIgnoreCase);

    private IEnumerable<IGrouping<string, DeviceDefinition>> GroupedDevices =>
        _deviceSortMode == "manufacturer"
            ? _devices.Where(MatchesSearch).OrderBy(d => d.Manufacturer, StringComparer.OrdinalIgnoreCase).ThenBy(d => d.Model)
                .GroupBy(d => d.Manufacturer, StringComparer.OrdinalIgnoreCase)
            : _devices.Where(MatchesSearch).OrderBy(d => d.Category, StringComparer.OrdinalIgnoreCase).ThenBy(d => d.Model)
                .GroupBy(d => d.Category, StringComparer.OrdinalIgnoreCase);

    private string _currentUsername = "";
    private string _currentRole = "";
    private string _createdBy = "";
    private DateTimeOffset? _createdAt = null;
    private string _modifiedBy = "";
    private DateTimeOffset? _modifiedAt = null;

    private record AuthStatus(bool HasUsers, bool IsAuthenticated, string? Username, string? Role,
                              bool UsingTemporaryPassword);

    // True while the account is still on the placeholder password. Server-driven and only
    // cleared by actually changing it — the prompt it drives cannot be dismissed.
    private bool _mustChangePassword;
    private NodeModel? _resizingNode = null;
    private ResizeHandle _resizeHandleKind = ResizeHandle.TopLeft;
    private Point _resizeStartMouse = new(0, 0);
    private Point _resizeStartPos = new(0, 0);
    private Blazor.Diagrams.Core.Geometry.Size _resizeStartSize = new(0, 0);
    private Point _resizeStartLineStart = new(0, 0);
    private Point _resizeStartLineEnd = new(0, 0);

    public enum ResizeHandle { TopLeft, TopRight, BottomLeft, BottomRight, LineStart, LineEnd }

    protected override async Task OnInitializedAsync()
    {
        _diagram = new BlazorDiagram();
        _diagram.Options.Links.DefaultRouter = new ElbowRouter();
        _diagram.Options.Links.DefaultPathGenerator = new Blazor.Diagrams.Core.PathGenerators.StraightPathGenerator();
        _diagram.RegisterComponent<LineFlowNode, LineFlowNodeWidget>();
        _diagram.RegisterComponent<LegendNode, LegendNodeWidget>();
        _diagram.RegisterComponent<BoxNode, BoxNodeWidget>();
        _diagram.RegisterComponent<LineNode, LineNodeWidget>();
        _diagram.RegisterComponent<TextNode, TextNodeWidget>();
        _diagram.RegisterComponent<ConnectionLabelNode, ConnectionLabelWidget>();
        _diagram.RegisterComponent<BreakTagNode, BreakTagWidget>();
        _diagram.PointerDown += OnDiagramPointerDown;
        _diagram.Links.Added += (link) => OnLinkAdded((LinkModel)link);
        _diagram.Links.Removed += (link) =>
        {
            if (link is ElbowLinkModel elbow)
            {
                if (elbow.LabelNode != null)
                    _diagram.Nodes.Remove(elbow.LabelNode);
                RemoveBreakVisuals(elbow);   // deleting a broken connection takes its tag blocks too
            }
        };
        _diagram.Nodes.Removed += (node) =>
        {
            if (node is ConnectionLabelNode cln && cln.OwnerLink != null)
            {
                cln.OwnerLink.LabelText = null;
                cln.OwnerLink.LabelNode = null;
            }
            // Deleting a tag block directly (Delete key) rejoins its connection — the twin
            // block and both stubs go with it. Guarded so bulk clears/load don't cascade.
            if (node is BreakTagNode tag && !_removingBreakVisuals && !_loadingDiagram &&
                tag.OwnerLink is { IsBroken: true } owner)
            {
                owner.IsBroken = false;
                RemoveBreakVisuals(owner);
                ApplyCableColor(owner);
                owner.Refresh();
                owner.LabelNode?.Refresh();
            }
        };

        var shortcuts = _diagram.GetBehavior<Blazor.Diagrams.Core.Behaviors.KeyboardShortcutsBehavior>();
        if (shortcuts != null)
        {
            // Wrap the library's default Delete so it lands on the undo stack first
            shortcuts.SetShortcut("Delete", ctrl: false, shift: false, alt: false, async d =>
            {
                if (_diagram.Nodes.Any(n => n.Selected) || _diagram.Links.Any(l => l.Selected))
                    PushUndoSnapshot();
                await Blazor.Diagrams.Core.Behaviors.KeyboardShortcutsDefaults.DeleteSelection(d);
                await InvokeAsync(StateHasChanged);
            });
            shortcuts.SetShortcut("z", ctrl: true, shift: false, alt: false, _ => { Undo(); return ValueTask.CompletedTask; });
            shortcuts.SetShortcut("y", ctrl: true, shift: false, alt: false, _ => { Redo(); return ValueTask.CompletedTask; });
            shortcuts.SetShortcut("c", ctrl: true, shift: false, alt: false, _ => { CopySelection(); return ValueTask.CompletedTask; });
            shortcuts.SetShortcut("v", ctrl: true, shift: false, alt: false, _ => { PasteClipboard(); return ValueTask.CompletedTask; });

            shortcuts.SetShortcut("Escape", ctrl: false, shift: false, alt: false, _ => { ClearTrace(); return ValueTask.CompletedTask; });

            // Arrow-key nudge: 1px per press, 10px with Shift.
            foreach (var (key, dx, dy) in new[] { ("ArrowLeft", -1.0, 0.0), ("ArrowRight", 1.0, 0.0), ("ArrowUp", 0.0, -1.0), ("ArrowDown", 0.0, 1.0) })
            {
                var (ndx, ndy) = (dx, dy);
                shortcuts.SetShortcut(key, ctrl: false, shift: false, alt: false, _ => { NudgeSelection(ndx, ndy); return ValueTask.CompletedTask; });
                shortcuts.SetShortcut(key, ctrl: false, shift: true, alt: false, _ => { NudgeSelection(ndx * 10, ndy * 10); return ValueTask.CompletedTask; });
            }
        }

        await LoadDevices();
        await LoadAuthStatus();
        await LoadLogo();
    }

    private DotNetObjectReference<Home>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            // Wire the middle-mouse double-click zoom-to-fit gesture. Guarded so a stale
            // cached index.html without the helper just leaves the feature inactive.
            try { await JS.InvokeVoidAsync("registerMiddleDblClickZoom", _selfRef); }
            catch { }
        }
    }

    // Invoked from JS on a middle-mouse-button double-click: frame the entire diagram so
    // content that was panned or zoomed out of view is easy to find again. Uses the same
    // node + link-vertex bounds as PDF export, then centers it in the current viewport.
    [JSInvokable]
    public async Task ZoomToFitContent()
    {
        double minX = double.MaxValue, minY = double.MaxValue, maxX = double.MinValue, maxY = double.MinValue;
        foreach (var n in _diagram.Nodes)
        {
            double w = n.Size?.Width ?? 220;
            double h = n.Size?.Height ?? 140;
            minX = Math.Min(minX, n.Position.X);
            minY = Math.Min(minY, n.Position.Y);
            maxX = Math.Max(maxX, n.Position.X + w);
            maxY = Math.Max(maxY, n.Position.Y + h);
        }
        foreach (var link in _diagram.Links)
            foreach (var v in link.Vertices)
            {
                minX = Math.Min(minX, v.Position.X);
                minY = Math.Min(minY, v.Position.Y);
                maxX = Math.Max(maxX, v.Position.X);
                maxY = Math.Max(maxY, v.Position.Y);
            }
        if (maxX <= minX || maxY <= minY) return; // empty canvas — nothing to frame

        double[] size;
        try { size = await JS.InvokeAsync<double[]>("getCanvasAreaSize"); }
        catch { return; }
        if (size == null || size.Length < 2) return;
        double vw = size[0], vh = size[1];
        if (vw <= 0 || vh <= 0) return;

        const double margin = 60;
        double contentW = (maxX - minX) + margin * 2;
        double contentH = (maxY - minY) + margin * 2;
        double zoom = Math.Min(vw / contentW, vh / contentH);
        zoom = Math.Clamp(zoom, 0.1, 2.0);

        // screen = diagram * zoom + pan; place the content's center at the viewport center.
        double centerX = (minX + maxX) / 2;
        double centerY = (minY + maxY) / 2;
        double panX = vw / 2 - centerX * zoom;
        double panY = vh / 2 - centerY * zoom;

        _diagram.SetZoom(zoom);
        _diagram.SetPan(panX, panY);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _selfRef?.Dispose();
    }

    private async Task LoadAuthStatus()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<AuthStatus>("api/auth/status");
            _currentUsername = status?.Username ?? "";
            _currentRole = status?.Role ?? "";
            _mustChangePassword = status?.UsingTemporaryPassword ?? false;
        }
        catch
        {
            // If this fails the auth gate will redirect to /login on the next request anyway.
        }
    }

