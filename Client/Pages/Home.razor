    private void DeleteSelected()
    {
        if (!_diagram.Nodes.Any(n => n.Selected) && !_diagram.Links.Any(l => l.Selected)) return;
        PushUndoSnapshot();
        foreach (var node in _diagram.Nodes.Where(n => n.Selected).ToList())
            _diagram.Nodes.Remove(node);
        foreach (var link in _diagram.Links.Where(l => l.Selected).ToList())
            _diagram.Links.Remove(link);
    }

    private void AddLegend()
    {
        // Legend lists the cable types actually used by connections (name + color),
        // in the order they appear in the Cable Types panel.
        var usedNames = _diagram.Links.OfType<ElbowLinkModel>()
            .Select(l => l.CableTypeName)
            .Where(n => !string.IsNullOrEmpty(n))
            .Select(n => n!)
            .Distinct()
            .ToHashSet();

        var entries = _cableTypes
            .Where(c => usedNames.Contains(c.Name))
            .Select(c => (c.Name, c.Color, c.PartNumber, c.CableColor))
            .ToList();

        if (entries.Count == 0) return;

        PushUndoSnapshot();

        // Update existing legend if present, otherwise create one
        var existing = _diagram.Nodes.OfType<LegendNode>().FirstOrDefault();
        if (existing != null)
        {
            existing.Entries = entries;
            existing.Refresh();
            return;
        }

        var legend = new LegendNode(new Point(20, 20)) { Entries = entries };
        _diagram.Nodes.Add(legend);
    }

    private void TogglePlacement(string mode)
    {
        _placementMode = _placementMode == mode ? "" : mode;
        _placingDevice = null;
    }

    private void ToggleDevicePlacement(DeviceDefinition device)
    {
        if (_placementMode == "device" && _placingDevice == device)
        {
            _placementMode = "";
            _placingDevice = null;
        }
        else
        {
            _placementMode = "device";
            _placingDevice = device;
        }
    }

    private void ToggleMenu(string name)
    {
        _openMenu = _openMenu == name ? null : name;
    }

    private void CloseMenus()
    {
        _openMenu = null;
    }

    private void OnCanvasClick(MouseEventArgs e)
    {
        HideContextMenu();

        if (_placementMode == "")
            return;

        PushUndoSnapshot();
        var point = new Point(e.ClientX - 220, e.ClientY - 48);

        switch (_placementMode)
        {
            case "box":
                _diagram.Nodes.Add(new BoxNode(point));
                break;
            case "line":
                _diagram.Nodes.Add(new LineNode(point));
                break;
            case "text":
                _diagram.Nodes.Add(new TextNode(point) { Editing = true });
                break;
            case "device":
                if (_placingDevice != null)
                    _diagram.Nodes.Add(new LineFlowNode(point, _placingDevice));
                break;
        }

        _placementMode = "";
        _placingDevice = null;
    }

    public void StartResize(NodeModel node, ResizeHandle handle, MouseEventArgs e)
    {
        CapturePointerSnapshot();
        _resizingNode = node;
        _resizeHandleKind = handle;
        _resizeStartMouse = new Point(e.ClientX, e.ClientY);
        _resizeStartPos = node.Position;
        _resizeStartSize = node.Size ?? new Blazor.Diagrams.Core.Geometry.Size(160, 100);

        if (node is LineNode line)
        {
            _resizeStartLineStart = line.Start;
            _resizeStartLineEnd = line.End;
        }
    }

    private void OnCanvasMouseMove(MouseEventArgs e)
    {
        if (_resizingNode == null) return;

        double zoom = _diagram.Zoom == 0 ? 1 : _diagram.Zoom;
        double dx = (e.ClientX - _resizeStartMouse.X) / zoom;
        double dy = (e.ClientY - _resizeStartMouse.Y) / zoom;

        if (_resizingNode is LineNode line)
        {
            var fixedAbs = _resizeHandleKind == ResizeHandle.LineStart
                ? new Point(_resizeStartPos.X + _resizeStartLineEnd.X, _resizeStartPos.Y + _resizeStartLineEnd.Y)
                : new Point(_resizeStartPos.X + _resizeStartLineStart.X, _resizeStartPos.Y + _resizeStartLineStart.Y);
            var movingAbs = _resizeHandleKind == ResizeHandle.LineStart
                ? new Point(_resizeStartPos.X + _resizeStartLineStart.X + dx, _resizeStartPos.Y + _resizeStartLineStart.Y + dy)
                : new Point(_resizeStartPos.X + _resizeStartLineEnd.X + dx, _resizeStartPos.Y + _resizeStartLineEnd.Y + dy);

            double minX = Math.Min(fixedAbs.X, movingAbs.X);
            double minY = Math.Min(fixedAbs.Y, movingAbs.Y);
            double maxX = Math.Max(fixedAbs.X, movingAbs.X);
            double maxY = Math.Max(fixedAbs.Y, movingAbs.Y);

            line.SetPosition(minX, minY);
            line.Size = new Blazor.Diagrams.Core.Geometry.Size(Math.Max(maxX - minX, 1), Math.Max(maxY - minY, 1));

            if (_resizeHandleKind == ResizeHandle.LineStart)
            {
                line.Start = new Point(movingAbs.X - minX, movingAbs.Y - minY);
                line.End = new Point(fixedAbs.X - minX, fixedAbs.Y - minY);
            }
            else
            {
                line.End = new Point(movingAbs.X - minX, movingAbs.Y - minY);
                line.Start = new Point(fixedAbs.X - minX, fixedAbs.Y - minY);
            }
            line.Refresh();
            return;
        }

        if (_resizingNode is BoxNode box)
        {
            double newX = _resizeStartPos.X, newY = _resizeStartPos.Y;
            double newW = _resizeStartSize.Width, newH = _resizeStartSize.Height;

            switch (_resizeHandleKind)
            {
                case ResizeHandle.TopLeft: newX += dx; newY += dy; newW -= dx; newH -= dy; break;
                case ResizeHandle.TopRight: newY += dy; newW += dx; newH -= dy; break;
                case ResizeHandle.BottomLeft: newX += dx; newW -= dx; newH += dy; break;
                case ResizeHandle.BottomRight: newW += dx; newH += dy; break;
            }

            if (newW < 30) { if (_resizeHandleKind is ResizeHandle.TopLeft or ResizeHandle.BottomLeft) newX = _resizeStartPos.X + _resizeStartSize.Width - 30; newW = 30; }
            if (newH < 24) { if (_resizeHandleKind is ResizeHandle.TopLeft or ResizeHandle.TopRight) newY = _resizeStartPos.Y + _resizeStartSize.Height - 24; newH = 24; }

            box.SetPosition(newX, newY);
            box.Size = new Blazor.Diagrams.Core.Geometry.Size(newW, newH);
            box.Refresh();
        }
    }

    private void OnCanvasMouseUp(MouseEventArgs e)
    {
        _resizingNode = null;
        CommitPointerSnapshot();
    }

    private async Task LoadDevices()
    {
        try
        {
            var devices = await Http.GetFromJsonAsync<List<DeviceDefinition>>("api/devices");
            if (devices != null) _devices = devices;
        }
        catch (Exception ex)
        {
            Console.WriteLine("Failed to load devices: " + ex.Message);
        }
    }

    // Signal types aren't a fixed list. These are the stock ones; anything already used
    // anywhere in the shared library joins them, so a type someone invents (Dante, AES67,
    // 12G-SDI…) becomes a suggestion for everyone once that device is saved. Deriving the
    // list from real usage means there's nothing to keep in sync and no orphaned entries.
    private static readonly string[] BuiltInPortTypes =
        { "HDMI", "SDI", "Audio", "Network", "USB", "IR", "COM", "Other" };

    private IEnumerable<string> PortTypeSuggestions =>
        BuiltInPortTypes
            .Concat(_devices.SelectMany(d => d.Ports).Select(p => p.Type))
            .Concat(_newPorts.Select(p => p.Type))   // include what's being typed right now
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .Select(t => t.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(t => t, StringComparer.OrdinalIgnoreCase);

    private void AddPort()
    {
        _newPorts.Add(new PortDefinition { Name = "", Type = "HDMI", Direction = "In" });
    }

    private void RemovePort(int index)
    {
        _newPorts.RemoveAt(index);
    }

    private async Task AddDevice()
    {
        if (string.IsNullOrWhiteSpace(_newModel)) return;

        var device = new DeviceDefinition
        {
            Manufacturer = _newManufacturer,
            Model = _newModel,
            Category = _newCategory,
            Ports = _newPorts.ToList()
        };

        try
        {
            var response = await Http.PostAsJsonAsync("api/devices", device);
            if (response.IsSuccessStatusCode)
            {
                _devices.Add(device);
                _newManufacturer = "";
                _newModel = "";
                _newCategory = "";
                _newPorts.Clear();
                _deviceModalOpen = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Failed to add device: " + ex.Message);
        }
    }

    private void OpenAddDeviceModal()
    {
        CancelEditDevice();
        _deviceModalOpen = true;
    }

    private void StartEditDevice(int index)
    {
        var d = _devices[index];
        _editingIndex = index;
        _newManufacturer = d.Manufacturer;
        _newModel = d.Model;
        _newCategory = d.Category;
        _newPorts = d.Ports.Select(p => new PortDefinition { Name = p.Name, Type = p.Type, Direction = p.Direction }).ToList();
        _deviceModalOpen = true;
        StateHasChanged();
    }

    // Opens the Add-Device modal pre-filled with a copy of an existing device (ports
    // deep-copied), so a near-identical device can be created by tweaking one field.
    private void DuplicateDevice(int index)
    {
        var d = _devices[index];
        _editingIndex = -1;                 // add-new mode → "+ Add Device" saves a new one
        _newManufacturer = d.Manufacturer;
        _newModel = $"{d.Model} Copy";
        _newCategory = d.Category;
        _newPorts = d.Ports.Select(p => new PortDefinition { Name = p.Name, Type = p.Type, Direction = p.Direction }).ToList();
        _deviceModalOpen = true;
        StateHasChanged();
    }

    private async Task SaveEditDevice()
    {
        if (string.IsNullOrWhiteSpace(_newModel) || _editingIndex < 0) return;

        var device = new DeviceDefinition
        {
            Manufacturer = _newManufacturer,
            Model = _newModel,
            Category = _newCategory,
            Ports = _newPorts.ToList()
        };

        try
        {
            var response = await Http.PutAsJsonAsync($"api/devices/{_editingIndex}", device);
            if (response.IsSuccessStatusCode)
            {
                _devices[_editingIndex] = device;
                CancelEditDevice();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Failed to update device: " + ex.Message);
        }
    }

    private void CancelEditDevice()
    {
        _editingIndex = -1;
        _newManufacturer = "";
        _newModel = "";
        _newCategory = "";
        _newPorts.Clear();
        _deviceModalOpen = false;
        StateHasChanged();
    }

    private async Task DeleteDevice(int index)
    {
        try
        {
            var response = await Http.DeleteAsync($"api/devices/{index}");
            if (response.IsSuccessStatusCode)
            {
                _devices.RemoveAt(index);
                if (_editingIndex == index) CancelEditDevice();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Failed to delete device: " + ex.Message);
        }
    }

    private void OnDeviceDragStart(DeviceDefinition device)
    {
        _draggingDevice = device;
    }

    private void OnCanvasDrop(DragEventArgs e)
    {
        if (_draggingDevice == null) return;

        PushUndoSnapshot();
        var node = _diagram.Nodes.Add(new LineFlowNode(
            new Point(e.ClientX - 220, e.ClientY - 48),
            _draggingDevice));

        _draggingDevice = null;
        StateHasChanged();
    }

    private async Task NewDiagram()
    {
        // New replaces the whole document (all sheets) — confirm instead of relying on
        // undo, which is per sheet and never spans documents.
        if (_isDirty && !await JS.InvokeAsync<bool>("confirm", "Start a new diagram? Unsaved changes will be lost."))
            return;
        _undoStack.Clear();
        _redoStack.Clear();
        _pendingPointerSnapshot = null;
        _sheets = new List<Sheet> { new Sheet() };
        _activeSheetIndex = 0;
        _renamingSheetIndex = -1;
        _titleBlock = new TitleBlockInfo();
        _loadingDiagram = true;
        try
        {
            _diagram.Nodes.Clear();
            _diagram.Links.Clear();
        }
        finally { _loadingDiagram = false; }
        _cableTypes.Clear();
        _createdBy = "";
        _createdAt = null;
        _modifiedBy = "";
        _modifiedAt = null;
        MarkClean();
    }

    // Per-item serializers, shared by full-diagram saves/snapshots (BuildDiagramData) and
    // by clipboard copy (CopySelection) so both produce identical JSON shapes.
    private object NodeToJson(LineFlowNode n) => new
    {
        id = n.Id,
        label = n.Label,
        manufacturer = n.Device.Manufacturer,
        model = n.Device.Model,
        category = n.Device.Category,
        ports = n.Device.Ports,
        x = n.Position.X,
        y = n.Position.Y,
        backgroundColor = n.BackgroundColor,
        borderColor = n.BorderColor,
        textColor = n.TextColor
    };

    private object LinkToJson(BaseLinkModel l) => new
    {
        sourceNodeId = (l.Source.Model as PortModel)?.Parent.Id,
        sourcePortIndex = (l.Source.Model as PortModel) is PortModel sp
            ? sp.Parent.Ports.ToList().IndexOf(sp) : 0,
        targetNodeId = (l.Target!.Model as PortModel)?.Parent.Id,
        targetPortIndex = (l.Target.Model as PortModel) is PortModel tp
            ? tp.Parent.Ports.ToList().IndexOf(tp) : 0,
        // A broken link's bends are parked in StashedVertices — save those so the bends
        // survive save/open while broken and reappear on rejoin.
        vertices = (l as ElbowLinkModel)?.StashedVertices is { Count: > 0 } sv
            ? sv.Select(p => new { x = p.X, y = p.Y })
            : l.Vertices.Select(v => new { x = v.Position.X, y = v.Position.Y }),
        label = (l as ElbowLinkModel)?.LabelText ?? "",
        labelX = (l as ElbowLinkModel)?.LabelNode?.Position.X,
        labelY = (l as ElbowLinkModel)?.LabelNode?.Position.Y,
        labelRotation = (l as ElbowLinkModel)?.LabelNode?.Rotation ?? 0,
        cableType = (l as ElbowLinkModel)?.CableTypeName,
        broken = (l as ElbowLinkModel)?.IsBroken ?? false,
        srcTagX = (l as ElbowLinkModel)?.SrcTagNode?.Position.X,
        srcTagY = (l as ElbowLinkModel)?.SrcTagNode?.Position.Y,
        tgtTagX = (l as ElbowLinkModel)?.TgtTagNode?.Position.X,
        tgtTagY = (l as ElbowLinkModel)?.TgtTagNode?.Position.Y
    };

    private object BoxToJson(BoxNode b) => new
    {
        x = b.Position.X,
        y = b.Position.Y,
        width = b.Size?.Width ?? 160,
        height = b.Size?.Height ?? 100,
        borderColor = b.BorderColor
    };

    private object LineToJson(LineNode l) => new
    {
        x = l.Position.X,
        y = l.Position.Y,
        startX = l.Start.X,
        startY = l.Start.Y,
        endX = l.End.X,
        endY = l.End.Y,
        strokeColor = l.StrokeColor
    };

    private object TextToJson(TextNode t) => new
    {
        x = t.Position.X,
        y = t.Position.Y,
        text = t.Text,
        fontSize = t.FontSize,
        color = t.Color
    };

    // Shared serializer for both .lf file saves and undo/redo snapshots. Meta is only
    // added by SaveDiagram — snapshots deliberately exclude it so undo never rewrites
    // the created-by/modified-by info bar.
    private Dictionary<string, object?> BuildDiagramData()
    {
        return new Dictionary<string, object?>
        {
            ["nodes"] = _diagram.Nodes.OfType<LineFlowNode>().Select(NodeToJson).ToList(),
            // Skip links still being dragged (target not attached to a port yet)
            ["links"] = _diagram.Links
                .Where(l => l.Source.Model is PortModel && l.Target?.Model is PortModel)
                .Select(LinkToJson).ToList(),
            ["boxes"] = _diagram.Nodes.OfType<BoxNode>().Select(BoxToJson).ToList(),
            ["lines"] = _diagram.Nodes.OfType<LineNode>().Select(LineToJson).ToList(),
            ["texts"] = _diagram.Nodes.OfType<TextNode>().Select(TextToJson).ToList(),
            ["legend"] = _diagram.Nodes.OfType<LegendNode>().Select(g => new
            {
                x = g.Position.X,
                y = g.Position.Y,
                entries = g.Entries.Select(en => new { type = en.Name, color = en.Color, partNumber = en.PartNumber, cableColor = en.CableColor }).ToList()
            }).FirstOrDefault(),
            ["cableTypes"] = _cableTypes.Select(c => new { name = c.Name, color = c.Color, prefix = c.Prefix, partNumber = c.PartNumber, cableColor = c.CableColor }).ToList()
        };
    }

    private string SerializeDiagramState()
        => JsonSerializer.Serialize(BuildDiagramData());

    private bool CanPaste => _clipboardJson != null;

    // Copies the currently-selected nodes (devices + box/line/text annotations) to an in-app
    // clipboard. Connections are included only when BOTH of their endpoints are among the
    // copied devices, so duplicating a connected group brings the wiring along. The legend and
    // connection-label nodes are intentionally not copyable.
    private void CopySelection()
    {
        var deviceNodes = _diagram.Nodes.OfType<LineFlowNode>().Where(n => n.Selected).ToList();
        var boxNodes = _diagram.Nodes.OfType<BoxNode>().Where(n => n.Selected).ToList();
        var lineNodes = _diagram.Nodes.OfType<LineNode>().Where(n => n.Selected).ToList();
        var textNodes = _diagram.Nodes.OfType<TextNode>().Where(n => n.Selected).ToList();

        if (deviceNodes.Count + boxNodes.Count + lineNodes.Count + textNodes.Count == 0)
            return;

        var deviceIds = deviceNodes.Select(n => n.Id).ToHashSet();
        var links = _diagram.Links.Where(l =>
            l.Source.Model is PortModel sp && l.Target?.Model is PortModel tp &&
            deviceIds.Contains(sp.Parent.Id) && deviceIds.Contains(tp.Parent.Id)).ToList();

        var data = new Dictionary<string, object?>
        {
            ["nodes"] = deviceNodes.Select(NodeToJson).ToList(),
            ["links"] = links.Select(LinkToJson).ToList(),
            ["boxes"] = boxNodes.Select(BoxToJson).ToList(),
            ["lines"] = lineNodes.Select(LineToJson).ToList(),
            ["texts"] = textNodes.Select(TextToJson).ToList()
        };
        _clipboardJson = JsonSerializer.Serialize(data);
        _pasteSequence = 0;
    }

    // Pastes the clipboard onto the canvas, offset from the originals and re-selected so the
    // copy can be dragged immediately. Undoable. Repeated pastes step the offset so they don't
    // stack. Device nodes get fresh ids; copied connections are re-created against the new nodes.
    private void PasteClipboard()
    {
        if (_clipboardJson == null) return;
        var doc = JsonDocument.Parse(_clipboardJson);

        _pasteSequence++;
        double off = 30 * _pasteSequence;

        PushUndoSnapshot();
        _diagram.UnselectAll();

        var newNodes = new List<NodeModel>();
        var idMap = new Dictionary<string, LineFlowNode>();

        foreach (var nodeEl in doc.RootElement.GetProperty("nodes").EnumerateArray())
        {
            var oldId = nodeEl.GetProperty("id").GetString()!;
            var device = new DeviceDefinition
            {
                Manufacturer = nodeEl.GetProperty("manufacturer").GetString() ?? "",
                Model = nodeEl.GetProperty("model").GetString() ?? "",
                Category = nodeEl.GetProperty("category").GetString() ?? "",
                Ports = nodeEl.GetProperty("ports").Deserialize<List<PortDefinition>>() ?? new()
            };
            var node = new LineFlowNode(
                new Point(nodeEl.GetProperty("x").GetDouble() + off, nodeEl.GetProperty("y").GetDouble() + off), device);
            if (nodeEl.TryGetProperty("backgroundColor", out var nbg) && nbg.ValueKind == JsonValueKind.String)
                node.BackgroundColor = nbg.GetString() ?? "#16213e";
            if (nodeEl.TryGetProperty("borderColor", out var nbc) && nbc.ValueKind == JsonValueKind.String)
                node.BorderColor = nbc.GetString() ?? "#e94560";
            if (nodeEl.TryGetProperty("textColor", out var ntc) && ntc.ValueKind == JsonValueKind.String)
                node.TextColor = ntc.GetString() ?? "#ffffff";
            if (nodeEl.TryGetProperty("label", out var nlb) && nlb.ValueKind == JsonValueKind.String)
                node.Label = nlb.GetString() ?? "";
            _diagram.Nodes.Add(node);
            idMap[oldId] = node;
            newNodes.Add(node);
        }

        foreach (var linkEl in doc.RootElement.GetProperty("links").EnumerateArray())
        {
            var sourceNodeId = linkEl.GetProperty("sourceNodeId").GetString()!;
            var sourcePortIndex = linkEl.GetProperty("sourcePortIndex").GetInt32();
            var targetNodeId = linkEl.GetProperty("targetNodeId").GetString()!;
            var targetPortIndex = linkEl.GetProperty("targetPortIndex").GetInt32();

            if (idMap.TryGetValue(sourceNodeId, out var sourceNode) &&
                idMap.TryGetValue(targetNodeId, out var targetNode) &&
                sourcePortIndex < sourceNode.Ports.Count &&
                targetPortIndex < targetNode.Ports.Count)
            {
                var link = new ElbowLinkModel(
                    (PortModel)sourceNode.Ports[sourcePortIndex],
                    (PortModel)targetNode.Ports[targetPortIndex]);

                // Preserve the pasted link's cable type (color resolves from current types).
                if (linkEl.TryGetProperty("cableType", out var lctEl) && lctEl.ValueKind == JsonValueKind.String)
                    link.CableTypeName = lctEl.GetString();
                if (linkEl.TryGetProperty("broken", out var lbrEl) && (lbrEl.ValueKind == JsonValueKind.True || lbrEl.ValueKind == JsonValueKind.False))
                    link.IsBroken = lbrEl.GetBoolean();
                Point? srcTagPos = null, tgtTagPos = null;
                if (linkEl.TryGetProperty("srcTagX", out var stx) && stx.ValueKind == JsonValueKind.Number &&
                    linkEl.TryGetProperty("srcTagY", out var sty) && sty.ValueKind == JsonValueKind.Number)
                    srcTagPos = new Point(stx.GetDouble() + off, sty.GetDouble() + off);
                if (linkEl.TryGetProperty("tgtTagX", out var ttx) && ttx.ValueKind == JsonValueKind.Number &&
                    linkEl.TryGetProperty("tgtTagY", out var tty) && tty.ValueKind == JsonValueKind.Number)
                    tgtTagPos = new Point(ttx.GetDouble() + off, tty.GetDouble() + off);

                if (linkEl.TryGetProperty("vertices", out var vertsEl))
                {
                    foreach (var v in vertsEl.EnumerateArray())
                        link.Vertices.Add(new LinkVertexModel(link,
                            new Point(v.GetProperty("x").GetDouble() + off, v.GetProperty("y").GetDouble() + off)));
                }

                _diagram.Links.Add(link);

                if (linkEl.TryGetProperty("label", out var labelEl) && labelEl.ValueKind == JsonValueKind.String)
                {
                    var labelText = labelEl.GetString();
                    if (!string.IsNullOrEmpty(labelText))
                    {
                        link.LabelText = labelText;
                        var labelPos = linkEl.TryGetProperty("labelX", out var lxEl) && lxEl.ValueKind != JsonValueKind.Null &&
                                        linkEl.TryGetProperty("labelY", out var lyEl) && lyEl.ValueKind != JsonValueKind.Null
                            ? new Point(lxEl.GetDouble() + off, lyEl.GetDouble() + off)
                            : ComputeLinkMidpoint(link);
                        var labelNode = new ConnectionLabelNode(labelPos) { Text = labelText, OwnerLink = link };
                        if (linkEl.TryGetProperty("labelRotation", out var lrEl) && lrEl.ValueKind == JsonValueKind.Number)
                            labelNode.Rotation = ((lrEl.GetInt32() % 360) + 360) % 360;
                        link.LabelNode = labelNode;
                        _diagram.Nodes.Add(labelNode);
                    }
                }

                // After the label exists, so the tag blocks carry its text. Loaded bends are
                // parked so their handles don't render along the invisible line.
                if (link.IsBroken)
                {
                    StashVertices(link);
                    CreateBreakVisuals(link, srcTagPos, tgtTagPos);
                }
            }
        }

        foreach (var b in doc.RootElement.GetProperty("boxes").EnumerateArray())
        {
            var box = new BoxNode(new Point(b.GetProperty("x").GetDouble() + off, b.GetProperty("y").GetDouble() + off))
            {
                Size = new Blazor.Diagrams.Core.Geometry.Size(b.GetProperty("width").GetDouble(), b.GetProperty("height").GetDouble()),
                BorderColor = b.TryGetProperty("borderColor", out var bc) ? bc.GetString() ?? "#e94560" : "#e94560"
            };
            _diagram.Nodes.Add(box);
            newNodes.Add(box);
        }

        foreach (var l in doc.RootElement.GetProperty("lines").EnumerateArray())
        {
            var line = new LineNode(new Point(l.GetProperty("x").GetDouble() + off, l.GetProperty("y").GetDouble() + off))
            {
                Start = new Point(l.GetProperty("startX").GetDouble(), l.GetProperty("startY").GetDouble()),
                End = new Point(l.GetProperty("endX").GetDouble(), l.GetProperty("endY").GetDouble()),
                StrokeColor = l.TryGetProperty("strokeColor", out var sc) ? sc.GetString() ?? "#333333" : "#333333"
            };
            line.Size = new Blazor.Diagrams.Core.Geometry.Size(
                Math.Max(Math.Abs(line.End.X - line.Start.X), 1),
                Math.Max(Math.Abs(line.End.Y - line.Start.Y), 1));
            _diagram.Nodes.Add(line);
            newNodes.Add(line);
        }

        foreach (var t in doc.RootElement.GetProperty("texts").EnumerateArray())
        {
            var text = new TextNode(new Point(t.GetProperty("x").GetDouble() + off, t.GetProperty("y").GetDouble() + off))
            {
                Text = t.GetProperty("text").GetString() ?? "Text",
                FontSize = t.TryGetProperty("fontSize", out var fs) ? fs.GetInt32() : 16,
                Color = t.TryGetProperty("color", out var c) ? c.GetString() ?? "#222222" : "#222222"
            };
            _diagram.Nodes.Add(text);
            newNodes.Add(text);
        }

        foreach (var n in newNodes)
            _diagram.SelectModel(n, false);

        StateHasChanged();
    }

    private void DuplicateContextNode()
    {
        _contextMenuVisible = false;
        // Duplicate the whole selection; if the right-clicked node isn't part of it, act on just it.
        if (_contextNode != null && !_contextNode.Selected)
        {
            _diagram.UnselectAll();
            _diagram.SelectModel(_contextNode, false);
        }
        _contextNode = null;
        CopySelection();
        PasteClipboard();
    }

    // Extracts a sheet's canvas content from parked JSON as {name, nodes, links, boxes,
    // lines, texts, legend} — shared properties (cableTypes/meta) are written once at the
    // document root instead.
    private static Dictionary<string, object?> SheetContentFromJson(Sheet sheet, string json)
    {
        var dict = new Dictionary<string, object?>
        {
            ["name"] = sheet.Name,
            ["drawingTitle"] = sheet.DrawingTitle,
            ["drawingNumber"] = sheet.DrawingNumber
        };
        using var doc = JsonDocument.Parse(json);
        foreach (var prop in doc.RootElement.EnumerateObject())
            if (prop.Name is "nodes" or "links" or "boxes" or "lines" or "texts" or "legend")
                dict[prop.Name] = prop.Value.Clone();
        return dict;
    }

    private async Task SaveDiagram()
    {
        var now = DateTimeOffset.UtcNow;
        if (string.IsNullOrEmpty(_createdBy))
        {
            _createdBy = _currentUsername;
            _createdAt = now;
        }
        _modifiedBy = _currentUsername;
        _modifiedAt = now;

        ParkActiveSheet();   // sync the active sheet's parked JSON
        var data = new Dictionary<string, object?>
        {
            ["sheets"] = _sheets.Select(s => SheetContentFromJson(s, s.Json ?? EmptySheetJson)).ToList(),
            ["activeSheet"] = _activeSheetIndex,
            ["titleBlock"] = _titleBlock,
            ["cableTypes"] = _cableTypes.Select(c => new { name = c.Name, color = c.Color, prefix = c.Prefix, partNumber = c.PartNumber, cableColor = c.CableColor }).ToList(),
            ["meta"] = new
            {
                createdBy = _createdBy,
                createdAt = _createdAt,
                modifiedBy = _modifiedBy,
                modifiedAt = _modifiedAt
            }
        };

        var json = JsonSerializer.Serialize(data,
            new JsonSerializerOptions { WriteIndented = true });

        await JS.InvokeVoidAsync("saveAsFile", "diagram.lf", json);
        MarkClean();
    }

    private async Task OpenDiagram(InputFileChangeEventArgs e)
    {
        using var stream = e.File.OpenReadStream();
        using var reader = new System.IO.StreamReader(stream);
        var json = await reader.ReadToEndAsync();

        // Opening replaces the whole document (all sheets), so cross-document undo would
        // be unsound — guard with a confirm instead when there are unsaved changes.
        if (_isDirty && !await JS.InvokeAsync<bool>("confirm", "Open this file? Unsaved changes will be lost."))
            return;

        // Older files saved before metadata tracking simply leave these reset.
        _createdBy = "";
        _createdAt = null;
        _modifiedBy = "";
        _modifiedAt = null;

        LoadDocumentJson(json);
        MarkClean();
    }

    // Loads a whole .lf document. New-format files carry a "sheets" array with shared
    // cableTypes/meta at the root; older single-sheet files ARE the sheet, so they load
    // as "Sheet 1" through the same per-sheet path. Undo history resets — it's per sheet
    // and never spans documents.
    private void LoadDocumentJson(string json)
    {
        _undoStack.Clear();
        _redoStack.Clear();
        _pendingPointerSnapshot = null;

        using var doc = JsonDocument.Parse(json);
        var root = doc.RootElement;

        // Title block is document-wide; absent on older files, which just get an empty one.
        _titleBlock = root.TryGetProperty("titleBlock", out var tbEl) && tbEl.ValueKind == JsonValueKind.Object
            ? tbEl.Deserialize<TitleBlockInfo>() ?? new TitleBlockInfo()
            : new TitleBlockInfo();
        if (root.TryGetProperty("sheets", out var sheetsEl) && sheetsEl.ValueKind == JsonValueKind.Array)
        {
            _sheets = sheetsEl.EnumerateArray()
                .Select((el, i) => new Sheet
                {
                    Name = el.TryGetProperty("name", out var nEl) && nEl.ValueKind == JsonValueKind.String
                        ? nEl.GetString() ?? $"Sheet {i + 1}"
                        : $"Sheet {i + 1}",
                    DrawingTitle = el.TryGetProperty("drawingTitle", out var dtEl) && dtEl.ValueKind == JsonValueKind.String
                        ? dtEl.GetString() ?? "" : "",
                    DrawingNumber = el.TryGetProperty("drawingNumber", out var dnEl) && dnEl.ValueKind == JsonValueKind.String
                        ? dnEl.GetString() ?? "" : "",
                    Json = el.GetRawText()
                })
                .ToList();
            if (_sheets.Count == 0) _sheets = new List<Sheet> { new Sheet() };

            int active = root.TryGetProperty("activeSheet", out var aEl) && aEl.ValueKind == JsonValueKind.Number
                ? Math.Clamp(aEl.GetInt32(), 0, _sheets.Count - 1)
                : 0;

            // Meta lives at the document root in the sheets format.
            if (root.TryGetProperty("meta", out var metaEl) && metaEl.ValueKind == JsonValueKind.Object)
            {
                _createdBy = metaEl.TryGetProperty("createdBy", out var cb) ? cb.GetString() ?? "" : "";
                _createdAt = metaEl.TryGetProperty("createdAt", out var ca) && ca.ValueKind != JsonValueKind.Null ? ca.GetDateTimeOffset() : null;
                _modifiedBy = metaEl.TryGetProperty("modifiedBy", out var mb) ? mb.GetString() ?? "" : "";
                _modifiedAt = metaEl.TryGetProperty("modifiedAt", out var ma) && ma.ValueKind != JsonValueKind.Null ? ma.GetDateTimeOffset() : null;
            }

            // Load the active sheet's canvas, then install the shared cable types (the
            // sheet JSON has none of its own) and recolor.
            ActivateSheet(active);
            _cableTypes.Clear();
            if (root.TryGetProperty("cableTypes", out var ctsEl) && ctsEl.ValueKind == JsonValueKind.Array)
            {
                foreach (var ctEl in ctsEl.EnumerateArray())
                    _cableTypes.Add(new CableType
                    {
                        Name = ctEl.TryGetProperty("name", out var cn) ? cn.GetString() ?? "" : "",
                        Color = ctEl.TryGetProperty("color", out var cc) ? cc.GetString() ?? "#e94560" : "#e94560",
                        Prefix = ctEl.TryGetProperty("prefix", out var cp) ? cp.GetString() ?? "" : "",
                        PartNumber = ctEl.TryGetProperty("partNumber", out var cpn) ? cpn.GetString() ?? "" : "",
                        CableColor = ctEl.TryGetProperty("cableColor", out var ccl) ? ccl.GetString() ?? "" : ""
                    });
            }
            RefreshAllLinkColors();
        }
        else
        {
            // Legacy single-sheet file: the root IS the sheet (including its cableTypes).
            _sheets = new List<Sheet> { new Sheet() };
            _activeSheetIndex = 0;
            LoadDiagramJson(json);
        }
    }

    // Rebuilds the entire canvas from serialized diagram JSON. Used by both file open
    // and undo/redo restore (snapshots have no meta property, so meta is left alone).
    private void LoadDiagramJson(string json)
    {
        // Trace is view state over the current canvas — a rebuild invalidates it.
        _tracedNodes.Clear();
        _tracedLinks.Clear();

        var doc = JsonDocument.Parse(json);

        // Guarded so the tag-block rejoin hook doesn't fire while everything is torn down.
        _loadingDiagram = true;
        try
        {
            _diagram.Nodes.Clear();
            _diagram.Links.Clear();
        }
        finally { _loadingDiagram = false; }

        _cableTypes.Clear();
        if (doc.RootElement.TryGetProperty("cableTypes", out var ctsEl) && ctsEl.ValueKind == JsonValueKind.Array)
        {
            foreach (var ctEl in ctsEl.EnumerateArray())
                _cableTypes.Add(new CableType
                {
                    Name = ctEl.TryGetProperty("name", out var cn) ? cn.GetString() ?? "" : "",
                    Color = ctEl.TryGetProperty("color", out var cc) ? cc.GetString() ?? "#e94560" : "#e94560",
                    Prefix = ctEl.TryGetProperty("prefix", out var cp) ? cp.GetString() ?? "" : "",
                    PartNumber = ctEl.TryGetProperty("partNumber", out var cpn) ? cpn.GetString() ?? "" : "",
                    CableColor = ctEl.TryGetProperty("cableColor", out var ccl) ? ccl.GetString() ?? "" : ""
                });
        }

        if (doc.RootElement.TryGetProperty("meta", out var metaEl) && metaEl.ValueKind == JsonValueKind.Object)
        {
            _createdBy = metaEl.TryGetProperty("createdBy", out var cb) ? cb.GetString() ?? "" : "";
            _createdAt = metaEl.TryGetProperty("createdAt", out var ca) && ca.ValueKind != JsonValueKind.Null ? ca.GetDateTimeOffset() : null;
            _modifiedBy = metaEl.TryGetProperty("modifiedBy", out var mb) ? mb.GetString() ?? "" : "";
            _modifiedAt = metaEl.TryGetProperty("modifiedAt", out var ma) && ma.ValueKind != JsonValueKind.Null ? ma.GetDateTimeOffset() : null;
        }

        var nodeMap = new Dictionary<string, LineFlowNode>();

        foreach (var nodeEl in doc.RootElement.GetProperty("nodes").EnumerateArray())
        {
            var id = nodeEl.GetProperty("id").GetString()!;
            var x = nodeEl.GetProperty("x").GetDouble();
            var y = nodeEl.GetProperty("y").GetDouble();

            var device = new DeviceDefinition
            {
                Manufacturer = nodeEl.GetProperty("manufacturer").GetString() ?? "",
                Model = nodeEl.GetProperty("model").GetString() ?? "",
                Category = nodeEl.GetProperty("category").GetString() ?? "",
                Ports = nodeEl.GetProperty("ports").Deserialize<List<PortDefinition>>() ?? new()
            };

            var node = new LineFlowNode(new Point(x, y), device);
            if (nodeEl.TryGetProperty("backgroundColor", out var nbg) && nbg.ValueKind == JsonValueKind.String)
                node.BackgroundColor = nbg.GetString() ?? "#16213e";
            if (nodeEl.TryGetProperty("borderColor", out var nbc) && nbc.ValueKind == JsonValueKind.String)
                node.BorderColor = nbc.GetString() ?? "#e94560";
            if (nodeEl.TryGetProperty("textColor", out var ntc) && ntc.ValueKind == JsonValueKind.String)
                node.TextColor = ntc.GetString() ?? "#ffffff";
            if (nodeEl.TryGetProperty("label", out var nlb) && nlb.ValueKind == JsonValueKind.String)
                node.Label = nlb.GetString() ?? "";
            _diagram.Nodes.Add(node);
            nodeMap[id] = node;
        }

        foreach (var linkEl in doc.RootElement.GetProperty("links").EnumerateArray())
        {
            var sourceNodeId = linkEl.GetProperty("sourceNodeId").GetString()!;
            var sourcePortIndex = linkEl.GetProperty("sourcePortIndex").GetInt32();
            var targetNodeId = linkEl.GetProperty("targetNodeId").GetString()!;
            var targetPortIndex = linkEl.GetProperty("targetPortIndex").GetInt32();

            if (nodeMap.TryGetValue(sourceNodeId, out var sourceNode) &&
                nodeMap.TryGetValue(targetNodeId, out var targetNode) &&
                sourcePortIndex < sourceNode.Ports.Count &&
                targetPortIndex < targetNode.Ports.Count)
            {
                var link = new ElbowLinkModel(
                    (PortModel)sourceNode.Ports[sourcePortIndex],
                    (PortModel)targetNode.Ports[targetPortIndex]);

                // Cable type set before Add so SetupElbowLink colors it from the cable type.
                if (linkEl.TryGetProperty("cableType", out var lctEl) && lctEl.ValueKind == JsonValueKind.String)
                    link.CableTypeName = lctEl.GetString();
                if (linkEl.TryGetProperty("broken", out var lbrEl) && (lbrEl.ValueKind == JsonValueKind.True || lbrEl.ValueKind == JsonValueKind.False))
                    link.IsBroken = lbrEl.GetBoolean();
                Point? srcTagPos = null, tgtTagPos = null;
                if (linkEl.TryGetProperty("srcTagX", out var stx) && stx.ValueKind == JsonValueKind.Number &&
                    linkEl.TryGetProperty("srcTagY", out var sty) && sty.ValueKind == JsonValueKind.Number)
                    srcTagPos = new Point(stx.GetDouble(), sty.GetDouble());
                if (linkEl.TryGetProperty("tgtTagX", out var ttx) && ttx.ValueKind == JsonValueKind.Number &&
                    linkEl.TryGetProperty("tgtTagY", out var tty) && tty.ValueKind == JsonValueKind.Number)
                    tgtTagPos = new Point(ttx.GetDouble(), tty.GetDouble());

                // Restore vertices (new format)
                if (linkEl.TryGetProperty("vertices", out var vertsEl))
                {
                    foreach (var v in vertsEl.EnumerateArray())
                        link.Vertices.Add(new LinkVertexModel(link, new Point(v.GetProperty("x").GetDouble(), v.GetProperty("y").GetDouble())));
                }
                // Backward compat: old files saved midX only
                else if (linkEl.TryGetProperty("midX", out var midXEl) && midXEl.ValueKind != JsonValueKind.Null)
                {
                    link.MidX = midXEl.GetDouble();
                }

                _diagram.Links.Add(link);

                if (linkEl.TryGetProperty("label", out var labelEl) && labelEl.ValueKind == JsonValueKind.String)
                {
                    var labelText = labelEl.GetString();
                    if (!string.IsNullOrEmpty(labelText))
                    {
                        link.LabelText = labelText;
                        var labelPos = linkEl.TryGetProperty("labelX", out var lxEl) && lxEl.ValueKind != JsonValueKind.Null &&
                                        linkEl.TryGetProperty("labelY", out var lyEl) && lyEl.ValueKind != JsonValueKind.Null
                            ? new Point(lxEl.GetDouble(), lyEl.GetDouble())
                            : ComputeLinkMidpoint(link);
                        var labelNode = new ConnectionLabelNode(labelPos) { Text = labelText, OwnerLink = link };
                        if (linkEl.TryGetProperty("labelRotation", out var lrEl) && lrEl.ValueKind == JsonValueKind.Number)
                            labelNode.Rotation = ((lrEl.GetInt32() % 360) + 360) % 360;
                        link.LabelNode = labelNode;
                        _diagram.Nodes.Add(labelNode);
                    }
                }

                // After the label exists, so the tag blocks carry its text. Legacy broken
                // files without saved positions fall back to the default outward placement.
                // Loaded bends are parked so their handles don't render along the invisible line.
                if (link.IsBroken)
                {
                    StashVertices(link);
                    CreateBreakVisuals(link, srcTagPos, tgtTagPos);
                }
            }
        }

        if (doc.RootElement.TryGetProperty("boxes", out var boxesEl))
        {
            foreach (var b in boxesEl.EnumerateArray())
            {
                var box = new BoxNode(new Point(b.GetProperty("x").GetDouble(), b.GetProperty("y").GetDouble()))
                {
                    Size = new Blazor.Diagrams.Core.Geometry.Size(b.GetProperty("width").GetDouble(), b.GetProperty("height").GetDouble()),
                    BorderColor = b.TryGetProperty("borderColor", out var bc) ? bc.GetString() ?? "#e94560" : "#e94560"
                };
                _diagram.Nodes.Add(box);
            }
        }

        if (doc.RootElement.TryGetProperty("lines", out var linesEl))
        {
            foreach (var l in linesEl.EnumerateArray())
            {
                var line = new LineNode(new Point(l.GetProperty("x").GetDouble(), l.GetProperty("y").GetDouble()))
                {
                    Start = new Point(l.GetProperty("startX").GetDouble(), l.GetProperty("startY").GetDouble()),
                    End = new Point(l.GetProperty("endX").GetDouble(), l.GetProperty("endY").GetDouble()),
                    StrokeColor = l.TryGetProperty("strokeColor", out var sc) ? sc.GetString() ?? "#333333" : "#333333"
                };
                line.Size = new Blazor.Diagrams.Core.Geometry.Size(
                    Math.Max(Math.Abs(line.End.X - line.Start.X), 1),
                    Math.Max(Math.Abs(line.End.Y - line.Start.Y), 1));
                _diagram.Nodes.Add(line);
            }
        }

        if (doc.RootElement.TryGetProperty("texts", out var textsEl))
        {
            foreach (var t in textsEl.EnumerateArray())
            {
                var text = new TextNode(new Point(t.GetProperty("x").GetDouble(), t.GetProperty("y").GetDouble()))
                {
                    Text = t.GetProperty("text").GetString() ?? "Text",
                    FontSize = t.TryGetProperty("fontSize", out var fs) ? fs.GetInt32() : 16,
                    Color = t.TryGetProperty("color", out var c) ? c.GetString() ?? "#222222" : "#222222"
                };
                _diagram.Nodes.Add(text);
            }
        }

        if (doc.RootElement.TryGetProperty("legend", out var legendEl) && legendEl.ValueKind == JsonValueKind.Object)
        {
            var legend = new LegendNode(new Point(legendEl.GetProperty("x").GetDouble(), legendEl.GetProperty("y").GetDouble()));
            if (legendEl.TryGetProperty("entries", out var entriesEl))
            {
                foreach (var en in entriesEl.EnumerateArray())
                    legend.Entries.Add((
                        en.GetProperty("type").GetString() ?? "",
                        en.GetProperty("color").GetString() ?? "#e94560",
                        en.TryGetProperty("partNumber", out var epn) ? epn.GetString() ?? "" : "",
                        en.TryGetProperty("cableColor", out var ecc) ? ecc.GetString() ?? "" : ""));
            }
            _diagram.Nodes.Add(legend);
        }

        StateHasChanged();
    }

    private static string Csv(string? s)
    {
        s ??= "";
        return s.Contains(',') || s.Contains('"') || s.Contains('\n') || s.Contains('\r')
            ? "\"" + s.Replace("\"", "\"\"") + "\""
            : s;
    }

    // Both schedule exports cover EVERY sheet, so they read from each sheet's parked JSON
    // (the active sheet is parked first) instead of the live diagram. Yields (sheet name,
    // sheet root) pairs; consume each before advancing \u2014 the backing JsonDocument is
    // disposed when the iterator moves on.
    private IEnumerable<(string Name, JsonElement Root)> AllSheetRoots()
    {
        ParkActiveSheet();
        foreach (var s in _sheets)
        {
            using var doc = JsonDocument.Parse(s.Json ?? EmptySheetJson);
            yield return (s.Name, doc.RootElement);
        }
    }

    // Exports a cable schedule (pull sheet) as CSV: one row per connection across ALL
    // sheets, with its sheet, label, signal type, and source/destination device + port.
    // Sheets appear in tab order; within a sheet, rows sort by source device then source
    // port so cables from the same box group together.
    private async Task ExportCableSchedule()
    {
        var rows = new List<(string Sheet, string Cable, string CableType, string Signal,
                             string FromLabel, string FromDevice, string FromPort,
                             string ToLabel, string ToDevice, string ToPort)>();

        foreach (var (sheetName, root) in AllSheetRoots())
        {
            // id -> (tag, title, ports) lookup for this sheet's devices
            var nodes = new Dictionary<string, (string Label, string Title, List<PortDefinition> Ports)>();
            foreach (var n in root.GetProperty("nodes").EnumerateArray())
            {
                var mfr = n.TryGetProperty("manufacturer", out var mEl) ? mEl.GetString() ?? "" : "";
                var model = n.TryGetProperty("model", out var moEl) ? moEl.GetString() ?? "" : "";
                var label = n.TryGetProperty("label", out var lEl) ? lEl.GetString() ?? "" : "";
                var ports = n.TryGetProperty("ports", out var pEl) ? pEl.Deserialize<List<PortDefinition>>() ?? new() : new();
                nodes[n.GetProperty("id").GetString()!] = (label, $"{mfr} {model}".Trim(), ports);
            }

            var sheetRows = new List<(string Sheet, string Cable, string CableType, string Signal,
                                      string FromLabel, string FromDevice, string FromPort,
                                      string ToLabel, string ToDevice, string ToPort, int PortIdx)>();
            foreach (var l in root.GetProperty("links").EnumerateArray())
            {
                if (!nodes.TryGetValue(l.GetProperty("sourceNodeId").GetString() ?? "", out var src)) continue;
                if (!nodes.TryGetValue(l.GetProperty("targetNodeId").GetString() ?? "", out var tgt)) continue;
                int spi = l.GetProperty("sourcePortIndex").GetInt32();
                int tpi = l.GetProperty("targetPortIndex").GetInt32();
                if (spi >= src.Ports.Count || tpi >= tgt.Ports.Count) continue;
                sheetRows.Add((
                    sheetName,
                    l.TryGetProperty("label", out var lbEl) ? lbEl.GetString() ?? "" : "",
                    l.TryGetProperty("cableType", out var ctEl) && ctEl.ValueKind == JsonValueKind.String ? ctEl.GetString() ?? "" : "",
                    src.Ports[spi].Type,
                    src.Label, src.Title, src.Ports[spi].Name,
                    tgt.Label, tgt.Title, tgt.Ports[tpi].Name,
                    spi));
            }
            rows.AddRange(sheetRows
                .OrderBy(r => r.FromDevice, StringComparer.OrdinalIgnoreCase)
                .ThenBy(r => r.PortIdx)
                .Select(r => (r.Sheet, r.Cable, r.CableType, r.Signal,
                              r.FromLabel, r.FromDevice, r.FromPort,
                              r.ToLabel, r.ToDevice, r.ToPort)));
        }

        var sb = new System.Text.StringBuilder();
        sb.Append('\uFEFF'); // BOM so Excel opens the CSV with correct (UTF-8) encoding
        // From/To Tag sit before their device columns: with two of the same model, the model
        // name alone can't tell an interconnect apart from a port patched into itself.
        sb.AppendLine("#,Sheet,Cable,Cable Type,Part Number,Cable Color,Signal,From Tag,From Device,From Port,To Tag,To Device,To Port");
        int i = 1;
        foreach (var r in rows)
        {
            var ct = _cableTypes.FirstOrDefault(c => c.Name == r.CableType);
            sb.AppendLine(string.Join(",",
                i++.ToString(), Csv(r.Sheet), Csv(r.Cable), Csv(r.CableType), Csv(ct?.PartNumber ?? ""), Csv(ct?.CableColor ?? ""),
                Csv(r.Signal), Csv(r.FromLabel), Csv(r.FromDevice), Csv(r.FromPort),
                Csv(r.ToLabel), Csv(r.ToDevice), Csv(r.ToPort)));
        }

        await JS.InvokeVoidAsync("saveAsFile", "cable-schedule.csv", sb.ToString());
    }

    // Export -> Device Schedule: a BOM of the devices across ALL sheets, grouped into one
    // row per manufacturer+model with a quantity — the companion to the cable schedule
    // for quoting/ordering. Sorted by category then manufacturer, like the palette.
    private async Task ExportDeviceSchedule()
    {
        var counts = new Dictionary<(string Mfr, string Model, string Cat), int>();
        foreach (var (_, root) in AllSheetRoots())
        {
            foreach (var n in root.GetProperty("nodes").EnumerateArray())
            {
                var key = (
                    n.TryGetProperty("manufacturer", out var mEl) ? mEl.GetString() ?? "" : "",
                    n.TryGetProperty("model", out var moEl) ? moEl.GetString() ?? "" : "",
                    n.TryGetProperty("category", out var cEl) ? cEl.GetString() ?? "" : "");
                counts[key] = counts.GetValueOrDefault(key) + 1;
            }
        }

        var rows = counts
            .Select(kv => new { Qty = kv.Value, Manufacturer = kv.Key.Mfr, kv.Key.Model, Category = kv.Key.Cat })
            .OrderBy(r => r.Category, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.Manufacturer, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.Model, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var sb = new System.Text.StringBuilder();
        sb.Append((char)0xFEFF); // BOM so Excel opens the CSV with correct (UTF-8) encoding
        sb.AppendLine("Qty,Manufacturer,Model,Category");
        foreach (var r in rows)
            sb.AppendLine(string.Join(",", r.Qty.ToString(), Csv(r.Manufacturer), Csv(r.Model), Csv(r.Category)));

        await JS.InvokeVoidAsync("saveAsFile", "device-schedule.csv", sb.ToString());
    }

    private async Task ExportPdf()
    {
        // Compute the raw-coordinate bounds of the entire diagram (nodes + connection routing
        // vertices — elbow bends can extend well beyond the nodes they join). The JS side uses
        // these to capture the FULL content via an off-screen restyled clone, so nothing is
        // clipped no matter how large the diagram is or where the user has panned/zoomed.
        // The live view is never touched — no zoom jump, nothing to restore.
        double minX = double.MaxValue, minY = double.MaxValue, maxX = double.MinValue, maxY = double.MinValue;
        foreach (var n in _diagram.Nodes)
        {
            // Fall back to a typical node footprint if the browser hasn't measured it yet.
            double w = n.Size?.Width ?? 220;
            double h = n.Size?.Height ?? 140;
            minX = Math.Min(minX, n.Position.X);
            minY = Math.Min(minY, n.Position.Y);
            maxX = Math.Max(maxX, n.Position.X + w);
            maxY = Math.Max(maxY, n.Position.Y + h);
        }
        foreach (var link in _diagram.Links)
        {
            foreach (var v in link.Vertices)
            {
                minX = Math.Min(minX, v.Position.X);
                minY = Math.Min(minY, v.Position.Y);
                maxX = Math.Max(maxX, v.Position.X);
                maxY = Math.Max(maxY, v.Position.Y);
            }
        }

        const double margin = 40;
        double bx = 0, by = 0, bw = 0, bh = 0;
        if (maxX > minX)
        {
            bx = minX - margin;
            by = minY - margin;
            bw = (maxX - minX) + 2 * margin;
            bh = (maxY - minY) + 2 * margin;
        }

        // PDF captures the ACTIVE sheet; with several sheets the header names which one.
        var pdfTitle = _sheets.Count > 1
            ? $"{(string.IsNullOrWhiteSpace(_diagramTitle) ? "Line Flow Diagram" : _diagramTitle)} — {_sheets[_activeSheetIndex].Name}"
            : _diagramTitle;

        // The title block is document-wide except for the drawing title/number, which come
        // from the sheet being exported. Falls back to the diagram title so a sheet with no
        // explicit drawing title still prints something meaningful.
        var sheet = _sheets[_activeSheetIndex];
        var tb = new
        {
            enabled = _titleBlock.Enabled,
            sheetSize = _titleBlock.SheetSize,
            companyName = _titleBlock.CompanyName,
            companyAddress = _titleBlock.CompanyAddress,
            companyPhone = _titleBlock.CompanyPhone,
            companyWeb = _titleBlock.CompanyWeb,
            client = _titleBlock.Client,
            projectName = _titleBlock.ProjectName,
            location = _titleBlock.Location,
            discipline = _titleBlock.Discipline,
            projectNumber = _titleBlock.ProjectNumber,
            drawnBy = _titleBlock.DrawnBy,
            checkedBy = _titleBlock.CheckedBy,
            date = _titleBlock.Date,
            revisions = _titleBlock.Revisions.Select(r => new { number = r.Number, date = r.Date, description = r.Description }),
            drawingTitle = string.IsNullOrWhiteSpace(sheet.DrawingTitle) ? _diagramTitle : sheet.DrawingTitle,
            drawingNumber = sheet.DrawingNumber,
            sheetName = sheet.Name,
            logo = _logoDataUri
        };

        await JS.InvokeVoidAsync("exportToPdf", pdfTitle, AppVersion.Version, bx, by, bw, bh, tb);
    }

    // Text style written into the DXF and referenced by every TEXT entity. The font is the
    // file name CAD resolves at open time, so it must exist on the machine opening the
    // drawing — Arial ships with Windows and is mapped on macOS/Linux CAD too. Swap for
    // another .ttf (or an .shx) here if a project standard calls for something else.
    private const string DxfTextStyle = "LOOPBACK";
    private const string DxfTextFont = "arial.ttf";

    // Cable type name -> DXF layer name. R12 layer names are uppercase, max 31 characters,
    // and can't contain spaces or < > / \ " : ; ? * | = ' — so anything outside
    // letters/digits/$-_ becomes an underscore. The CABLE- prefix keeps them grouped
    // together in CAD's layer list, next to each other and away from NODES/ANNOTATIONS.
    private static string DxfLayerForCable(string cableTypeName)
    {
        var cleaned = new string((cableTypeName ?? "").Trim().ToUpperInvariant()
            .Select(c => char.IsLetterOrDigit(c) || c is '$' or '-' or '_' ? c : '_')
            .ToArray()).Trim('_');
        if (cleaned.Length == 0) cleaned = "UNNAMED";
        if (cleaned.Length > 25) cleaned = cleaned[..25];   // 6 for "CABLE-" + 25 = the 31 cap
        return "CABLE-" + cleaned;
    }

    // Nearest AutoCAD Color Index for a #rrggbb cable color. R12 predates true color
    // (code 420, R2000+), so layer colors come from the ACI palette; this matches against
    // the six primaries plus white and two grays. It's only a starting point — the reason
    // each cable type gets its own layer is so these can be restyled in CAD.
    private static int DxfAciColor(string? hex)
    {
        if (hex == null || hex.Length != 7 || hex[0] != '#'
            || !int.TryParse(hex.AsSpan(1), System.Globalization.NumberStyles.HexNumber, null, out var rgb))
            return 7;

        (int Aci, int R, int G, int B)[] palette =
        {
            (1, 255, 0, 0), (2, 255, 255, 0), (3, 0, 255, 0), (4, 0, 255, 255),
            (5, 0, 0, 255), (6, 255, 0, 255), (7, 255, 255, 255),
            (8, 128, 128, 128), (9, 192, 192, 192)
        };

        int r = (rgb >> 16) & 0xFF, g = (rgb >> 8) & 0xFF, b = rgb & 0xFF;
        int best = 7;
        long bestDistance = long.MaxValue;
        foreach (var (aci, pr, pg, pb) in palette)
        {
            long d = (long)(r - pr) * (r - pr) + (long)(g - pg) * (g - pg) + (long)(b - pb) * (b - pb);
            if (d < bestDistance) { bestDistance = d; best = aci; }
        }
        return best;
    }

    private async Task ExportDxf()
    {
        var sb = new System.Text.StringBuilder();

        double scale = 0.3;

        // Running extents of everything emitted, used to size the title-block sheet around
        // the finished drawing (DXF is model space — there's no page until we draw one).
        double exMinX = double.MaxValue, exMinY = double.MaxValue;
        double exMaxX = double.MinValue, exMaxY = double.MinValue;
        void Extend(double x, double y)
        {
            if (x < exMinX) exMinX = x;
            if (y < exMinY) exMinY = y;
            if (x > exMaxX) exMaxX = x;
            if (y > exMaxY) exMaxY = y;
        }

        // R12 (AC1009) is the most widely-compatible DXF flavor: unlike R2000+ (AC1015)
        // it needs no per-entity subclass markers (100 AcDbEntity/AcDbLine/...) or handles,
        // which this writer doesn't emit. Declaring AC1015 without them makes AutoCAD throw
        // a DXF read error and open a blank drawing.
        sb.AppendLine("0\nSECTION");
        sb.AppendLine("2\nHEADER");
        sb.AppendLine("9\n$ACADVER");
        sb.AppendLine("1\nAC1009");
        sb.AppendLine("0\nENDSEC");

        // Each cabling type used on this sheet gets its own layer, so colors, lineweights,
        // and visibility can be set per cable type in CAD (the layer's initial color is the
        // nearest ACI match to the on-screen color). Types with no connections on this sheet
        // are skipped, matching how the legend only lists what's actually used. Connections
        // with no cable type fall back to the generic CONNECTIONS layer.
        var cableLayers = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var takenLayers = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { "0", "NODES", "CONNECTIONS", "ANNOTATIONS", "LEGEND", "TITLEBLOCK" };
        foreach (var ctName in _diagram.Links.OfType<ElbowLinkModel>()
                     .Where(l => l.Source.Model is PortModel && l.Target?.Model is PortModel
                                 && !string.IsNullOrWhiteSpace(l.CableTypeName))
                     .Select(l => l.CableTypeName!)
                     .Distinct(StringComparer.OrdinalIgnoreCase))
        {
            var baseName = DxfLayerForCable(ctName);
            var layer = baseName;
            // Two type names can sanitize to the same layer ("Cat 6" / "Cat-6") — suffix dupes.
            for (int i = 2; !takenLayers.Add(layer); i++)
                layer = $"{baseName[..Math.Min(baseName.Length, 28)]}-{i}";
            cableLayers[ctName] = layer;
        }

        var layers = new List<(string Name, int Color)>
        {
            ("NODES", 7), ("CONNECTIONS", 7), ("ANNOTATIONS", 7), ("LEGEND", 7), ("TITLEBLOCK", 7)
        };
        foreach (var (typeName, layerName) in cableLayers)
            layers.Add((layerName, DxfAciColor(_cableTypes.FirstOrDefault(c => c.Name == typeName)?.Color)));

        sb.AppendLine("0\nSECTION");
        sb.AppendLine("2\nTABLES");
        sb.AppendLine("0\nTABLE");
        sb.AppendLine("2\nLAYER");
        sb.AppendLine($"70\n{layers.Count}");
        foreach (var (layerName, layerColor) in layers)
        {
            sb.AppendLine("0\nLAYER");
            sb.AppendLine($"2\n{layerName}");
            sb.AppendLine("70\n0");
            sb.AppendLine($"62\n{layerColor}");
            sb.AppendLine("6\nCONTINUOUS");
        }
        sb.AppendLine("0\nENDTAB");

        // Text style. Without a STYLE table (and a 7 group on each TEXT naming it), CAD
        // falls back to the "Standard" style, whose default font is the txt.shx monoline
        // stick font — legible but ugly. Group code 3 is the primary font file; naming a
        // TrueType file there ("arial.ttf") gets a normal-looking font instead. A custom
        // style name is used rather than redefining "Standard", so importing this drawing
        // into an existing one doesn't restyle that drawing's own text.
        sb.AppendLine("0\nTABLE");
        sb.AppendLine("2\nSTYLE");
        sb.AppendLine("70\n1");
        sb.AppendLine("0\nSTYLE");
        sb.AppendLine($"2\n{DxfTextStyle}");
        sb.AppendLine("70\n0");
        sb.AppendLine("40\n0.0");   // 0 = height comes from each TEXT entity, not fixed here
        sb.AppendLine("41\n1.0");   // width factor
        sb.AppendLine("50\n0.0");   // oblique angle
        sb.AppendLine("71\n0");
        sb.AppendLine("42\n2.5");
        sb.AppendLine($"3\n{DxfTextFont}");
        sb.AppendLine("4\n");       // bigfont file: none
        sb.AppendLine("0\nENDTAB");

        sb.AppendLine("0\nENDSEC");

        sb.AppendLine("0\nSECTION");
        sb.AppendLine("2\nENTITIES");

        var portPositions = new Dictionary<string, (double x, double y)>();

        // DXF requires a '.' decimal separator regardless of the user's locale, so format
        // every coordinate with the invariant culture (a comma-decimal locale would
        // otherwise emit "12,34" and corrupt the file).
        static string F(double v) => v.ToString("F4", System.Globalization.CultureInfo.InvariantCulture);

        void DxfLine(double x1, double y1, double x2, double y2, string layer = "NODES")
        {
            if (layer != "TITLEBLOCK") { Extend(x1, y1); Extend(x2, y2); }
            sb.AppendLine("0\nLINE");
            sb.AppendLine($"8\n{layer}");
            sb.AppendLine($"10\n{F(x1)}");
            sb.AppendLine($"20\n{F(y1)}");
            sb.AppendLine("30\n0.0");
            sb.AppendLine($"11\n{F(x2)}");
            sb.AppendLine($"21\n{F(y2)}");
            sb.AppendLine("31\n0.0");
        }

        // Filled quad, used for the legend's color swatches.
        void DxfSolid(double x1, double y1, double x2, double y2, string layer)
        {
            Extend(x1, y1); Extend(x2, y2);
            sb.AppendLine("0\nSOLID");
            sb.AppendLine($"8\n{layer}");
            // SOLID corner order is bottom-left, bottom-right, TOP-LEFT, TOP-RIGHT — the
            // third and fourth points are swapped versus a normal quad winding. Ordering
            // them the "obvious" way renders an hourglass instead of a rectangle.
            sb.AppendLine($"10\n{F(x1)}"); sb.AppendLine($"20\n{F(y1)}"); sb.AppendLine("30\n0.0");
            sb.AppendLine($"11\n{F(x2)}"); sb.AppendLine($"21\n{F(y1)}"); sb.AppendLine("31\n0.0");
            sb.AppendLine($"12\n{F(x1)}"); sb.AppendLine($"22\n{F(y2)}"); sb.AppendLine("32\n0.0");
            sb.AppendLine($"13\n{F(x2)}"); sb.AppendLine($"23\n{F(y2)}"); sb.AppendLine("33\n0.0");
        }

        void DxfText(double tx, double ty, string text, double height = 2.5, string layer = "NODES", int halign = 0, double rotation = 0)
        {
            if (layer != "TITLEBLOCK") Extend(tx, ty);
            sb.AppendLine("0\nTEXT");
            sb.AppendLine($"8\n{layer}");
            sb.AppendLine($"10\n{F(tx)}");
            sb.AppendLine($"20\n{F(ty)}");
            sb.AppendLine("30\n0.0");
            sb.AppendLine($"40\n{F(height)}");
            sb.AppendLine($"1\n{text ?? ""}");
            if (rotation != 0)
                sb.AppendLine($"50\n{F(rotation)}");
            sb.AppendLine($"7\n{DxfTextStyle}");
            sb.AppendLine($"72\n{halign}");
            sb.AppendLine($"11\n{F(tx)}");
            sb.AppendLine($"21\n{F(ty)}");
            sb.AppendLine("31\n0.0");
        }

        (double x, double y) PolylineMidpoint(List<(double x, double y)> pts)
        {
            double total = 0;
            for (int i = 0; i < pts.Count - 1; i++)
                total += Math.Sqrt(Math.Pow(pts[i + 1].x - pts[i].x, 2) + Math.Pow(pts[i + 1].y - pts[i].y, 2));

            double target = total / 2;
            double covered = 0;
            for (int i = 0; i < pts.Count - 1; i++)
            {
                double segLen = Math.Sqrt(Math.Pow(pts[i + 1].x - pts[i].x, 2) + Math.Pow(pts[i + 1].y - pts[i].y, 2));
                if (segLen <= 0) continue;
                if (covered + segLen >= target)
                {
                    double t = (target - covered) / segLen;
                    return (pts[i].x + (pts[i + 1].x - pts[i].x) * t, pts[i].y + (pts[i + 1].y - pts[i].y) * t);
                }
                covered += segLen;
            }
            return pts[^1];
        }

        foreach (var node in _diagram.Nodes.OfType<LineFlowNode>())
        {
            var leftPorts = node.Ports.OfType<LineFlowPort>()
                .Where(p => p.Alignment == PortAlignment.Left).ToList();
            var rightPorts = node.Ports.OfType<LineFlowPort>()
                .Where(p => p.Alignment == PortAlignment.Right).ToList();

            int maxPorts = Math.Max(leftPorts.Count, rightPorts.Count);
            double portHeight = 16;
            double titleHeight = 20;
            double padding = 8;
            double nodeHeight = titleHeight + (maxPorts * portHeight) + padding;
            double nodeWidth = 180;

            double x = node.Position.X * scale;
            double y = -(node.Position.Y * scale);
            double w = nodeWidth * scale;
            double h = nodeHeight * scale;
            double sph = portHeight * scale;
            double sth = titleHeight * scale;

            DxfLine(x, y, x + w, y);
            DxfLine(x + w, y, x + w, y - h);
            DxfLine(x + w, y - h, x, y - h);
            DxfLine(x, y - h, x, y);
            DxfLine(x, y - sth, x + w, y - sth);
            // Tag first when set, so two of the same model are distinguishable in CAD too.
            var nodeTitle = string.IsNullOrWhiteSpace(node.Label) ? node.Title : $"[{node.Label}] {node.Title}";
            DxfText(x + w / 2, y - sth + sth * 0.3, nodeTitle, 2.5, "NODES", 1);

            for (int i = 0; i < leftPorts.Count; i++)
            {
                double py = y - sth - (i * sph) - (sph * 0.5);
                double px = x;
                DxfText(px + 1, py - 1, leftPorts[i].Definition.Name, 1.8, "NODES", 0);
                portPositions[leftPorts[i].Id] = (px, py);
            }

            for (int i = 0; i < rightPorts.Count; i++)
            {
                double py = y - sth - (i * sph) - (sph * 0.5);
                double px = x + w;
                DxfText(px - 1, py - 1, rightPorts[i].Definition.Name, 1.8, "NODES", 2);
                portPositions[rightPorts[i].Id] = (px, py);
            }
        }

        foreach (var link in _diagram.Links)
        {
            if (link.Source.Model is not PortModel sourcePort) continue;
            if (link.Target?.Model is not PortModel targetPort) continue;
            if (!portPositions.TryGetValue(sourcePort.Id, out var srcPos)) continue;
            if (!portPositions.TryGetValue(targetPort.Id, out var tgtPos)) continue;

            var verts = link.Vertices;
            List<(double x, double y)> pts;

            // Vertices/label positions are in screen/port coordinate space.
            // Convert to DXF space using source port as reference:
            //   dxfX = (screenX - srcScreenX) * scale + srcPos.x
            //   dxfY = -(screenY - srcScreenY) * scale + srcPos.y  (Y axis is flipped in DXF)
            double srcScreenX = (sourcePort.Position?.X ?? 0) + (sourcePort.Size?.Width / 2 ?? 0);
            double srcScreenY = (sourcePort.Position?.Y ?? 0) + (sourcePort.Size?.Height / 2 ?? 0);

            (double x, double y) ToDxf(double sx, double sy) =>
                ((sx - srcScreenX) * scale + srcPos.x,
                 -(sy - srcScreenY) * scale + srcPos.y);

            if (verts.Count == 0)
            {
                // No vertices: centered elbow
                double midX = (srcPos.x + tgtPos.x) / 2;
                pts = new List<(double x, double y)> { srcPos, (midX, srcPos.y), (midX, tgtPos.y), tgtPos };
            }
            else if (verts.Count == 1)
            {
                // Simple H-V-H elbow using vertex X
                var (vx, _) = ToDxf(verts[0].Position.X, verts[0].Position.Y);
                pts = new List<(double x, double y)> { srcPos, (vx, srcPos.y), (vx, tgtPos.y), tgtPos };
            }
            else
            {
                // Multi-vertex: H-V-H-V-...-H matching the router's path
                var dv = verts.Select(v => ToDxf(v.Position.X, v.Position.Y)).ToList();

                pts = new List<(double x, double y)>();
                pts.Add(srcPos);
                pts.Add((dv[0].x, srcPos.y));
                for (int i = 0; i < dv.Count - 1; i++)
                {
                    pts.Add((dv[i].x, dv[i + 1].y));
                    pts.Add((dv[i + 1].x, dv[i + 1].y));
                }
                pts.Add((dv[^1].x, tgtPos.y));
                pts.Add(tgtPos);
            }

            // Everything belonging to this cable — line, label, break stubs and tags — goes
            // on its cable type's layer; unassigned connections stay on CONNECTIONS.
            var cableLayer = link is ElbowLinkModel typed && typed.CableTypeName != null
                             && cableLayers.TryGetValue(typed.CableTypeName, out var cl)
                ? cl : "CONNECTIONS";

            if (link is ElbowLinkModel brokenLink && brokenLink.IsBroken)
            {
                // Broken: a stub from each port to its tag block, tag text at the block —
                // mirroring the on-screen layout (blocks may have been dragged anywhere).
                var s = pts[0];
                var t = pts[^1];
                var tag = brokenLink.LabelText ?? "";
                if (brokenLink.SrcTagNode != null)
                {
                    var p = ToDxf(brokenLink.SrcTagNode.Position.X, brokenLink.SrcTagNode.Position.Y);
                    DxfLine(s.x, s.y, p.x, p.y, cableLayer);
                    DxfText(p.x, p.y, tag, 2.0, cableLayer, 0);
                }
                if (brokenLink.TgtTagNode != null)
                {
                    var p = ToDxf(brokenLink.TgtTagNode.Position.X, brokenLink.TgtTagNode.Position.Y);
                    DxfLine(t.x, t.y, p.x, p.y, cableLayer);
                    DxfText(p.x, p.y, tag, 2.0, cableLayer, 0);
                }
            }
            else
            {
                for (int i = 0; i < pts.Count - 1; i++)
                    DxfLine(pts[i].x, pts[i].y, pts[i + 1].x, pts[i + 1].y, cableLayer);

                if (link is ElbowLinkModel elbowLink && !string.IsNullOrEmpty(elbowLink.LabelText))
                {
                    var labelPos = elbowLink.LabelNode != null
                        ? ToDxf(elbowLink.LabelNode.Position.X, elbowLink.LabelNode.Position.Y)
                        : PolylineMidpoint(pts);
                    // Screen rotation is clockwise; the DXF Y-axis is flipped, which turns that
                    // into the counterclockwise-positive angle DXF's group code 50 expects.
                    double labelRot = elbowLink.LabelNode?.Rotation ?? 0;
                    DxfText(labelPos.x, labelPos.y, elbowLink.LabelText, 2.0, cableLayer, 1, labelRot);
                }
            }
        }

        foreach (var box in _diagram.Nodes.OfType<BoxNode>())
        {
            double x = box.Position.X * scale;
            double y = -(box.Position.Y * scale);
            double w = (box.Size?.Width ?? 160) * scale;
            double h = (box.Size?.Height ?? 100) * scale;

            DxfLine(x, y, x + w, y, "ANNOTATIONS");
            DxfLine(x + w, y, x + w, y - h, "ANNOTATIONS");
            DxfLine(x + w, y - h, x, y - h, "ANNOTATIONS");
            DxfLine(x, y - h, x, y, "ANNOTATIONS");
        }

        foreach (var line in _diagram.Nodes.OfType<LineNode>())
        {
            double x1 = (line.Position.X + line.Start.X) * scale;
            double y1 = -((line.Position.Y + line.Start.Y) * scale);
            double x2 = (line.Position.X + line.End.X) * scale;
            double y2 = -((line.Position.Y + line.End.Y) * scale);

            DxfLine(x1, y1, x2, y2, "ANNOTATIONS");
        }

        foreach (var text in _diagram.Nodes.OfType<TextNode>())
        {
            double x = text.Position.X * scale;
            double y = -(text.Position.Y * scale);

            DxfText(x, y, text.Text, Math.Max(text.FontSize * scale, 1.0), "ANNOTATIONS", 0);
        }

        // Legend, redrawn as a real CAD table (the on-screen one is an HTML table, which
        // has no DXF equivalent). Column widths are measured from the actual content so
        // nothing overlaps, and the Part #/Color columns appear only when in use — same
        // rule the on-screen legend follows.
        foreach (var legend in _diagram.Nodes.OfType<LegendNode>())
        {
            if (legend.Entries.Count == 0) continue;

            const double rowH = 5.5, textH = 2.0, cellPad = 1.6, swatchW = 5.0, swatchH = 2.6;
            // Generous per-character advance: real Arial is narrower, but over-estimating
            // only pads the cells, whereas under-estimating runs one column into the next.
            static double TextW(string? s, double h) => (s ?? "").Length * h * 0.78;

            bool anyPart = legend.Entries.Any(e => !string.IsNullOrWhiteSpace(e.PartNumber));
            bool anyColor = legend.Entries.Any(e => !string.IsNullOrWhiteSpace(e.CableColor));

            // Column widths: widest of header vs. content, plus padding on both sides.
            double Col(string header, Func<(string Name, string Color, string PartNumber, string CableColor), string?> pick)
                => Math.Max(TextW(header, textH), legend.Entries.Max(e => TextW(pick(e), textH))) + cellPad * 2;

            var colWidths = new List<double> { swatchW + cellPad * 2, Col("Cable Type", e => e.Name) };
            if (anyPart) colWidths.Add(Col("Part #", e => e.PartNumber));
            if (anyColor) colWidths.Add(Col("Color", e => e.CableColor));

            // Cell boundaries — the grid is drawn from these, so lines and text can't disagree.
            double lx = legend.Position.X * scale;
            double ly = -(legend.Position.Y * scale);   // top edge; DXF Y grows upward
            var colX = new List<double> { lx };
            foreach (var w in colWidths) colX.Add(colX[^1] + w);
            double right = colX[^1];

            int rowCount = legend.Entries.Count;
            double bottom = ly - rowH * (rowCount + 1);   // +1 for the header row
            int nameCol = 1;
            int partCol = anyPart ? 2 : -1;
            int colorCol = anyColor ? (anyPart ? 3 : 2) : -1;

            // Full grid: a horizontal rule at every row boundary, a vertical at every
            // column boundary — including the outer edges, which form the frame.
            for (int r = 0; r <= rowCount + 1; r++)
            {
                double gy = ly - rowH * r;
                DxfLine(lx, gy, right, gy, "LEGEND");
            }
            foreach (var gx in colX)
                DxfLine(gx, ly, gx, bottom, "LEGEND");

            // Header row
            double headerBaseline = ly - rowH + (rowH - textH) / 2;
            DxfText(colX[nameCol] + cellPad, headerBaseline, "Cable Type", textH, "LEGEND", 0);
            if (anyPart) DxfText(colX[partCol] + cellPad, headerBaseline, "Part #", textH, "LEGEND", 0);
            if (anyColor) DxfText(colX[colorCol] + cellPad, headerBaseline, "Color", textH, "LEGEND", 0);

            for (int i = 0; i < rowCount; i++)
            {
                var entry = legend.Entries[i];
                double rowBottom = ly - rowH * (i + 2);
                double baseline = rowBottom + (rowH - textH) / 2;

                // The swatch sits on its cable type's own layer, so recoloring that layer
                // in CAD updates the legend key to match instead of leaving it stale.
                var swatchLayer = cableLayers.TryGetValue(entry.Name ?? "", out var sl) ? sl : "LEGEND";
                double sx = colX[0] + cellPad, sy = rowBottom + (rowH - swatchH) / 2;
                DxfSolid(sx, sy, sx + swatchW, sy + swatchH, swatchLayer);
                // Outline on LEGEND so a pale swatch is still visible against white paper.
                DxfLine(sx, sy, sx + swatchW, sy, "LEGEND");
                DxfLine(sx + swatchW, sy, sx + swatchW, sy + swatchH, "LEGEND");
                DxfLine(sx + swatchW, sy + swatchH, sx, sy + swatchH, "LEGEND");
                DxfLine(sx, sy + swatchH, sx, sy, "LEGEND");

                DxfText(colX[nameCol] + cellPad, baseline, entry.Name, textH, "LEGEND", 0);
                if (anyPart) DxfText(colX[partCol] + cellPad, baseline, entry.PartNumber, textH, "LEGEND", 0);
                if (anyColor) DxfText(colX[colorCol] + cellPad, baseline, entry.CableColor, textH, "LEGEND", 0);
            }
        }

        // Title block: a drawing sheet laid out around the finished geometry. DXF is model
        // space with no notion of paper, so the sheet is sized to the chosen aspect ratio
        // and scaled up until the content fits inside its drawing area, then centered there.
        if (_titleBlock.Enabled && exMaxX > exMinX && exMaxY > exMinY)
        {
            var sheet = _sheets[_activeSheetIndex];
            double paperW = _titleBlock.SheetSize switch
            {
                "11x17" => 431.8, "Letter" => 279.4, _ => 297.0     // landscape mm
            };
            double paperH = _titleBlock.SheetSize switch
            {
                "11x17" => 279.4, "Letter" => 215.9, _ => 210.0
            };
            double aspect = paperW / paperH;

            const double stripFrac = 0.113, marginFrac = 0.02;
            double drawWFrac = 1 - stripFrac - marginFrac * 2;
            double drawHFrac = 1 - marginFrac * 2;

            double contentW = (exMaxX - exMinX) * 1.06;   // breathing room
            double contentH = (exMaxY - exMinY) * 1.06;
            double sheetW = Math.Max(contentW / drawWFrac, contentH / drawHFrac * aspect);
            double sheetH = sheetW / aspect;

            // Centre the drawing area on the content.
            double contentCX = (exMinX + exMaxX) / 2, contentCY = (exMinY + exMaxY) / 2;
            double left = contentCX - sheetW * marginFrac - sheetW * drawWFrac / 2;
            double bottom = contentCY - sheetH * marginFrac - sheetH * drawHFrac / 2;
            double right = left + sheetW, top = bottom + sheetH;

            const string TB = "TITLEBLOCK";
            double t = sheetH * 0.011;                     // base text height
            double pad = sheetH * 0.008;
            void Rect(double ax, double ay, double bx2, double by2)
            {
                DxfLine(ax, ay, bx2, ay, TB); DxfLine(bx2, ay, bx2, by2, TB);
                DxfLine(bx2, by2, ax, by2, TB); DxfLine(ax, by2, ax, ay, TB);
            }

            // Double border
            Rect(left, bottom, right, top);
            double ib = sheetH * 0.006;
            Rect(left + ib, bottom + ib, right - ib, top - ib);

            double sx = right - ib - sheetW * stripFrac;   // strip left edge
            double sTop = top - ib, sBot = bottom + ib, sRight = right - ib;
            DxfLine(sx, sBot, sx, sTop, TB);
            void Rule(double ry) => DxfLine(sx, ry, sRight, ry, TB);

            double y = sTop;

            // Logo box (intentionally empty) + company details, right-aligned
            double logoH = sheetH * 0.10;
            Rect(sx + pad, y - logoH + pad, sRight - pad, y - pad);
            y -= logoH;
            foreach (var lineText in new[] { _titleBlock.CompanyName, _titleBlock.CompanyAddress,
                                             _titleBlock.CompanyPhone, _titleBlock.CompanyWeb })
            {
                if (string.IsNullOrWhiteSpace(lineText)) continue;
                y -= t * 1.6;
                DxfText(sRight - pad, y, lineText, t * 0.8, TB, 2);
            }
            y -= pad; Rule(y);

            // Everything from the revision grid down is ANCHORED TO THE BOTTOM of the strip,
            // matching the PDF and how a real sheet reads: the drawing number sits in a short
            // box in the bottom corner. Worked out first so the project and stamp blocks above
            // can divide up exactly the space that's actually left.
            const int revRows = 6;
            double revH = sheetH * 0.022;
            double numberBoxH = sheetH * 0.072, titleBoxH = sheetH * 0.072;
            double pairLead = t * 1.7;
            double pairsH = pairLead * 4 + pad;

            double numberTop = sBot + numberBoxH;
            double titleTop = numberTop + titleBoxH;
            double pairsTop = titleTop + pairsH;
            double revTop = Math.Min(pairsTop + revRows * revH, y - sheetH * 0.06);

            // Project block — rotated 90°, largest first. Takes the larger share of the space
            // between the company details and the revision grid; the stamp box gets the rest.
            double projBottom = y - (y - revTop) * 0.70;
            double px = sx + pad + t * 1.4;
            foreach (var (text, size) in new[]
            {
                (_titleBlock.Client, t * 1.9), (_titleBlock.ProjectName, t * 1.4),
                (_titleBlock.Location, t * 1.1), (_titleBlock.Discipline, t * 1.1)
            })
            {
                if (!string.IsNullOrWhiteSpace(text))
                    DxfText(px, projBottom + pad, text, size, TB, 0, 90);
                px += size * 1.5;
            }
            Rule(projBottom);

            // Stamp box: from the project block down to the revision grid.
            DxfText(sx + pad, projBottom - t * 1.6, "STAMP", t * 0.85, TB, 0);
            Rule(revTop);

            // Revisions grid
            double numW = sheetW * 0.014, dateW = sheetW * 0.030;
            for (int r = 1; r <= revRows; r++) Rule(revTop - r * revH);
            double revBottom = revTop - revRows * revH;
            DxfLine(sx + numW, revBottom, sx + numW, revTop, TB);
            DxfLine(sx + numW + dateW, revBottom, sx + numW + dateW, revTop, TB);
            DxfText(sx + pad * 0.6, revTop - revH + pad * 0.6, "#", t * 0.75, TB, 0);
            DxfText(sx + numW + pad * 0.6, revTop - revH + pad * 0.6, "DATE", t * 0.75, TB, 0);
            DxfText(sx + numW + dateW + pad * 0.6, revTop - revH + pad * 0.6, "DESCRIPTION", t * 0.75, TB, 0);
            for (int i = 0; i < _titleBlock.Revisions.Count && i < revRows - 1; i++)
            {
                var rev = _titleBlock.Revisions[i];
                double ry = revTop - revH * (i + 2) + pad * 0.6;
                DxfText(sx + pad * 0.6, ry, rev.Number, t * 0.8, TB, 0);
                DxfText(sx + numW + pad * 0.6, ry, rev.Date, t * 0.8, TB, 0);
                DxfText(sx + numW + dateW + pad * 0.6, ry, rev.Description, t * 0.8, TB, 0);
            }

            // Label / value pairs
            double py = pairsTop;
            foreach (var (label, value) in new[]
            {
                ("PROJECT NUM.", _titleBlock.ProjectNumber), ("DRAWN BY", _titleBlock.DrawnBy),
                ("CHECKED BY", _titleBlock.CheckedBy), ("DATE", _titleBlock.Date)
            })
            {
                py -= pairLead;
                DxfText(sx + pad, py, label, t * 0.85, TB, 0);
                DxfText(sRight - pad, py, value, t * 0.85, TB, 2);
            }
            Rule(titleTop);

            // Drawing title (per sheet)
            DxfText(sx + pad, titleTop - t * 1.5, "DRAWING TITLE", t * 0.8, TB, 0);
            var drawingTitle = string.IsNullOrWhiteSpace(sheet.DrawingTitle) ? _diagramTitle : sheet.DrawingTitle;
            DxfText(sx + pad, titleTop - t * 3.6, drawingTitle, t * 1.15, TB, 0);
            Rule(numberTop);

            // Drawing number: short box in the bottom corner
            DxfText(sx + pad, numberTop - t * 1.5, "DRAWING NUMBER", t * 0.8, TB, 0);
            DxfText(sRight - pad, sBot + t * 1.3, sheet.DrawingNumber, t * 2.0, TB, 2);
        }

        sb.AppendLine("0\nENDSEC");
        sb.AppendLine("0\nEOF");

        await JS.InvokeVoidAsync("saveAsFile", "diagram.dxf", sb.ToString());
    }

