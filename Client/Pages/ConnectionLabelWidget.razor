@* Hidden while the connection is broken — the label shows at the stub tags instead. *@
@if (!(Node.OwnerLink?.IsBroken ?? false))
{
    <div class="lf-connection-label"
         style="transform: translate(-50%, -50%) rotate(@(Node.Rotation)deg);">@Node.Text</div>
}

@code {
    [Parameter] public Home.ConnectionLabelNode Node { get; set; } = null!;
}
