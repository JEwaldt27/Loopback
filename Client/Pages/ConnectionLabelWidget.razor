@* Hidden while the connection is broken — the label shows at the tag blocks instead. *@
@if (!(Node.OwnerLink?.IsBroken ?? false))
{
    <div class="lf-connection-label @(Page?.TraceClassForLink(Node.OwnerLink))"
         style="transform: translate(-50%, -50%) rotate(@(Node.Rotation)deg);">@Node.Text</div>
}

@code {
    [Parameter] public ConnectionLabelNode Node { get; set; } = null!;
    [CascadingParameter] public Home Page { get; set; } = null!;
}
