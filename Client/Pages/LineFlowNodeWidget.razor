@using Blazor.Diagrams.Components.Renderers
@using Blazor.Diagrams.Core.Models

<div class="lf-node @(Page?.TraceClassFor(Node))" style="background:@Node.BackgroundColor;border-color:@Node.BorderColor;color:@Node.TextColor;">
    @if (Node.Selected)
    {
        <div class="lf-node-style-row" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true">
            <span class="lf-node-style-label">Fill</span>
            <input type="color" class="lf-node-color-input"
                   id="@($"node-fill-{Node.Id}")" name="@($"node-fill-{Node.Id}")"
                   title="Block fill color" value="@FillSwatch"
                   @oninput="e => OnColorInput(v => Node.BackgroundColor = v, e)" @onchange="EndColorEdit" />
            <button type="button"
                    class="lf-node-transparent-btn @(IsTransparent ? "lf-node-transparent-active" : "")"
                    title="Transparent fill" @onclick="ToggleTransparent"></button>
            <span class="lf-node-style-label">Line</span>
            <input type="color" class="lf-node-color-input"
                   id="@($"node-border-{Node.Id}")" name="@($"node-border-{Node.Id}")"
                   title="Block outline color" value="@Node.BorderColor"
                   @oninput="e => OnColorInput(v => Node.BorderColor = v, e)" @onchange="EndColorEdit" />
            <span class="lf-node-style-label">Text</span>
            <input type="color" class="lf-node-color-input"
                   id="@($"node-text-{Node.Id}")" name="@($"node-text-{Node.Id}")"
                   title="Block text color" value="@Node.TextColor"
                   @oninput="e => OnColorInput(v => Node.TextColor = v, e)" @onchange="EndColorEdit" />
        </div>
    }
    <div class="lf-node-title">@Node.Title</div>
    <div class="lf-node-body">
        <div class="lf-ports-left">
            @foreach (var port in Node.Ports.OfType<Home.LineFlowPort>()
                        .Where(p => p.Alignment == PortAlignment.Left))
            {
                var dotColor = "#000000";
                <div class="lf-port-row-left">
                    <PortRenderer Port="port" Class="lf-port-dot" Style="@($"background:{dotColor} !important;")" />
                    <span class="lf-port-label-left" style="color:@Node.TextColor;">@port.Definition.Name</span>
                </div>
            }
        </div>
        <div class="lf-ports-right">
            @foreach (var port in Node.Ports.OfType<Home.LineFlowPort>()
                        .Where(p => p.Alignment == PortAlignment.Right))
            {
                var dotColor = "#000000";
                <div class="lf-port-row-right">
                    <span class="lf-port-label-right" style="color:@Node.TextColor;">@port.Definition.Name</span>
                    <PortRenderer Port="port" Class="lf-port-dot" Style="@($"background:{dotColor} !important;")" />
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Home.LineFlowNode Node { get; set; } = null!;
    [CascadingParameter] public Home Page { get; set; } = null!;

    private const string DefaultColor = "#16213e";
    private bool _editingColor;

    private bool IsTransparent =>
        string.Equals(Node.BackgroundColor, "transparent", StringComparison.OrdinalIgnoreCase);

    // The native color input can't represent "transparent", so show the default swatch then.
    private string FillSwatch => IsTransparent ? DefaultColor : Node.BackgroundColor;

    // Live update on every 'input' as the user drags in the picker, but snapshot the undo
    // state only once (at the first input of a drag) and commit once on 'change', so a
    // single color pick is one undo step rather than dozens.
    private void OnColorInput(Action<string> set, ChangeEventArgs e)
    {
        if (!_editingColor) { Page?.CapturePointerSnapshot(); _editingColor = true; }
        set(e.Value?.ToString() ?? "");
    }

    private void EndColorEdit()
    {
        _editingColor = false;
        Page?.CommitPointerSnapshot();
    }

    private void ToggleTransparent()
    {
        Page?.CapturePointerSnapshot();
        Node.BackgroundColor = IsTransparent ? DefaultColor : "transparent";
        Page?.CommitPointerSnapshot();
    }
}
